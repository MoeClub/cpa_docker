+	baseModel, _, requestedEfforts, _ := resolveRequestedModelsForAccess(modelName, rawJSON)
+	if len(requestedEfforts) == 0 {
+		return baseModel, ""
+	}
+	return baseModel, requestedEfforts[len(requestedEfforts)-1]
