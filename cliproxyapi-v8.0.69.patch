+	reg := registry.GetGlobalRegistry()
+	clientID := "test-thinking-effective-deny-client"
+	reg.RegisterClient(clientID, "codex", []*registry.ModelInfo{
+		{
+			ID:   "test-deny-codex",
+			Type: "codex",
+			Thinking: &registry.ThinkingSupport{
+				Levels:       []string{"low", "medium", "high", "xhigh"},
+				DefaultLevel: "high",
+			},
+		},
+		{
+			ID:   "test-deny-argon",
+			Type: "antigravity",
+			Thinking: &registry.ThinkingSupport{
+				Levels:       []string{"low", "high"},
+				DefaultLevel: "high",
+				CodexLevelMap: []registry.CodexLevelMapping{
+					{Codex: "xhigh", Level: "high"},
+				},
+			},
+		},
+	})
+	t.Cleanup(func() { reg.UnregisterClient(clientID) })
+
+	if got := thinking.EffectiveAccessDenyEfforts("test-deny-codex", []string{"ultra"}); !slices.Contains(got, "xhigh") {
+		t.Fatalf("EffectiveAccessDenyEfforts(ultra) = %v, want xhigh included", got)
+	}
+	if got := thinking.EffectiveAccessDenyEfforts("test-deny-codex", []string{"32768"}); !slices.Contains(got, "xhigh") {
+		t.Fatalf("EffectiveAccessDenyEfforts(32768) = %v, want xhigh included", got)
+	}
+	if got := thinking.EffectiveAccessDenyEfforts("test-deny-argon", []string{"ultra"}); !slices.Contains(got, "high") {
+		t.Fatalf("EffectiveAccessDenyEfforts(argon ultra) = %v, want clamped high included", got)
+	}
+	if got := thinking.EffectiveAccessDenyEfforts("test-deny-argon", nil); !slices.Contains(got, "high") {
+		t.Fatalf("EffectiveAccessDenyEfforts(argon default) = %v, want default high included", got)
+	}
+}
