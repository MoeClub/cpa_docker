+func TestThinkingInnerWhitespaceSuffixAndEffectiveAccessDenyEfforts(t *testing.T) {
+	if !thinking.HasThinkingSuffix("gpt-5.4( low )") {
+		t.Fatal("HasThinkingSuffix(gpt-5.4( low )) = false, want true")
+	}
+	if lvl, ok := thinking.ParseLevelSuffix(" low "); !ok || lvl != thinking.LevelLow {
+		t.Fatalf("ParseLevelSuffix(\" low \") = (%q, %v), want (low, true)", lvl, ok)
