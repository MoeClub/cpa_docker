+
+func decodeAccessKeyModelList(node *yaml.Node) ([]string, error) {
+	if node == nil || node.Kind == 0 || node.Tag == "!!null" {
+		return nil, nil
+	}
+	switch node.Kind {
+	case yaml.ScalarNode:
+		val := strings.TrimSpace(node.Value)
+		if val == "" {
+			return nil, nil
+		}
+		return []string{val}, nil
+	case yaml.SequenceNode:
+		out := make([]string, 0, len(node.Content))
+		for _, child := range node.Content {
+			if child == nil || child.Tag == "!!null" {
+				continue
+			}
+			if child.Kind != yaml.ScalarNode {
+				return nil, fmt.Errorf("access model entry must be a string")
+			}
+			if val := strings.TrimSpace(child.Value); val != "" {
+				out = append(out, val)
+			}
+		}
+		return out, nil
+	default:
+		return nil, fmt.Errorf("access key models must be a list of strings")
+	}
+}
