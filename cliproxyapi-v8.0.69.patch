+// ClientAPIKeyFromContext extracts the authenticated client API key from ctx.
+func (h *BaseAPIHandler) ClientAPIKeyFromContext(ctx context.Context) string {
+	if ctx == nil {
+		return ""
+	}
+	return coreusage.APIKeyFromContext(ctx)
+}
+
+// ClientAPIKeyFromGin extracts the authenticated client API key from the Gin context.
+func (h *BaseAPIHandler) ClientAPIKeyFromGin(c *gin.Context) string {
+	if c == nil {
+		return ""
+	}
+	if value, exists := c.Get("userApiKey"); exists && value != nil {
+		if key := strings.TrimSpace(fmt.Sprint(value)); key != "" {
+			return key
+		}
+	}
+	if c.Request != nil {
+		return coreusage.APIKeyFromContext(c.Request.Context())
+	}
+	return ""
+}
