+		`data: {"id":"resp_reasoning_only_length","object":"chat.completion.chunk","created":1773896263,"model":"deepseek-v4.1-flash","choices":[{"index":0,"delta":{},"finish_reason":"length"}]}`,
+		`data: [DONE]`,
+	}
