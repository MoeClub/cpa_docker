+func inheritedModelAccessEffortFromContext(ctx context.Context) (string, string) {
+	if ctx == nil {
+		return "", ""
+	}
+	state, ok := ctx.Value(inheritedModelAccessEffortContextKey{}).(inheritedModelAccessEffort)
+	if !ok {
+		return "", ""
+	}
+	return state.baseModel, state.effort
