+func TestSyncAPIKeyModelsWithAPIKeys_BulkReplacementNeverMisassignsRules(t *testing.T) {
+	cfg := &Config{
+		SDKConfig: SDKConfig{
+			APIKeys: []string{"sk-guest", "sk-admin"},
+			APIKeyModels: map[string][]string{
+				"sk-guest": {"deepseek-v4.1-flash"},
+			},
+		},
+	}
+
+	// Bulk replacement: deleting index 0 ("sk-guest") and appending a new key ("sk-dev")
+	// keeps len == 2, so positional index matching would wrongly copy sk-guest's restriction
+	// onto sk-admin or sk-dev! Both indices changed here (0 and 1), and sk-admin already
+	// existed in prev, so neither sk-admin nor sk-dev may inherit sk-guest's rules.
+	prev := append([]string(nil), cfg.APIKeys...)
+	cfg.APIKeys = []string{"sk-admin", "sk-dev"}
+	cfg.SyncAPIKeyModelsWithAPIKeys(prev)
+
+	if !cfg.IsAPIKeyModelAllowed("sk-admin", "claude-opus-4-6") {
+		t.Fatal("sk-admin must remain unrestricted after deleting sk-guest and adding sk-dev")
+	}
+	if !cfg.IsAPIKeyModelAllowed("sk-dev", "claude-opus-4-6") {
+		t.Fatal("newly added sk-dev must not inherit deleted sk-guest restrictions on multi-index update")
+	}
+	if _, exists := cfg.APIKeyModels["sk-guest"]; exists {
+		t.Fatal("deleted sk-guest rules must be pruned")
+	}
+}
