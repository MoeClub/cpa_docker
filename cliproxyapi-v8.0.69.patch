+func applyAntigravitySystemInstructionRoleDoc(doc *ojson.Doc) {
+	if doc == nil || !doc.Get("request.systemInstruction").Exists() {
+		return
+	}
+	helps.SetStringIfDifferentDoc(doc, "request.systemInstruction.role", "user")
 }
 
