+
+func normalizeAccessKeysAndModels(root *yaml.Node, keysPath, modelsPath string, preserveEmptyModelsMap bool) (bool, error) {
+	if root == nil || root.Kind != yaml.MappingNode {
+		return false, nil
+	}
+	keysNode := yamlPath(root, keysPath)
+	modelsNode := yamlPath(root, modelsPath)
+	if keysNode == nil && modelsNode == nil {
+		return false, nil
+	}
+
+	// Fast-path check: if keysNode is already a scalar sequence and every key in
+	// modelsNode is already present in keysNode (with non-empty models or preserved
+	// explicit empty map), leave nodes untouched to preserve comments/styles.
+	if keysNode != nil && keysNode.Kind == yaml.SequenceNode && (modelsNode == nil || modelsNode.Kind == yaml.MappingNode) {
+		scalarKeys := make(map[string]struct{}, len(keysNode.Content))
+		allCanonicalScalars := true
+		for _, item := range keysNode.Content {
+			if item == nil || item.Kind != yaml.ScalarNode || item.Tag == "!!null" {
+				allCanonicalScalars = false
+				break
+			}
+			trimmed := strings.TrimSpace(item.Value)
+			if trimmed == "" || trimmed != item.Value {
+				allCanonicalScalars = false
+				break
+			}
+			scalarKeys[trimmed] = struct{}{}
+		}
+		if allCanonicalScalars && modelsNode == nil {
+			return false, nil
+		}
+		if allCanonicalScalars && modelsNode != nil && preserveEmptyModelsMap {
+			allModelsCanonical := true
+			for i := 0; i+1 < len(modelsNode.Content); i += 2 {
+				mk := modelsNode.Content[i]
+				mv := modelsNode.Content[i+1]
+				if mk == nil || mk.Kind != yaml.ScalarNode || mv == nil || mv.Kind != yaml.SequenceNode {
+					allModelsCanonical = false
+					break
+				}
+				if _, ok := scalarKeys[strings.TrimSpace(mk.Value)]; !ok {
+					allModelsCanonical = false
+					break
+				}
+			}
+			if allModelsCanonical {
+				return false, nil
+			}
+		}
+	}
+
+	var (
+		keyOrder        []string
+		seenKeys        = make(map[string]struct{})
+		seenInlineEntry = make(map[string]bool)
+		modelOrder      []string
+		modelsByKey     = make(map[string][]string)
+		seenModelsByKey = make(map[string]map[string]struct{})
+	)
+	addKey := func(rawKey string) string {
+		k := strings.TrimSpace(rawKey)
+		if k == "" {
+			return ""
+		}
+		if _, exists := seenKeys[k]; !exists {
+			seenKeys[k] = struct{}{}
+			keyOrder = append(keyOrder, k)
+		}
+		return k
+	}
+	recordKeysNodeEntry := func(rawKey string, isInlineMapping bool) error {
+		k := strings.TrimSpace(rawKey)
+		if k == "" {
+			if isInlineMapping {
+				return fmt.Errorf("access.api-keys mapping key must not be empty")
+			}
+			return nil
+		}
+		if hadInline, seen := seenInlineEntry[k]; seen && (isInlineMapping || hadInline) {
+			return fmt.Errorf("duplicate access.api-keys entry %q", k)
+		}
+		seenInlineEntry[k] = isInlineMapping
+		addKey(k)
+		return nil
+	}
+	addModels := func(rawKey string, models []string) {
+		k := addKey(rawKey)
+		if k == "" || len(models) == 0 {
+			return
+		}
+		seenModel := seenModelsByKey[k]
+		if seenModel == nil {
+			seenModel = make(map[string]struct{}, len(models))
+			seenModelsByKey[k] = seenModel
+		}
+		for _, m := range models {
+			trimmed := strings.TrimSpace(m)
+			if trimmed == "" {
+				continue
+			}
+			if _, exists := seenModel[trimmed]; exists {
+				continue
+			}
+			seenModel[trimmed] = struct{}{}
+			if _, hadKey := modelsByKey[k]; !hadKey {
+				modelOrder = append(modelOrder, k)
+			}
+			modelsByKey[k] = append(modelsByKey[k], trimmed)
+		}
+	}
+
+	if keysNode != nil && keysNode.Tag != "!!null" {
+		switch keysNode.Kind {
+		case yaml.SequenceNode:
+			for _, item := range keysNode.Content {
+				if item == nil || item.Tag == "!!null" {
+					continue
+				}
+				switch item.Kind {
+				case yaml.ScalarNode:
+					if err := recordKeysNodeEntry(item.Value, false); err != nil {
+						return false, err
+					}
+				case yaml.MappingNode:
+					if keyVal, mNode, ok := parseStructuredAccessAPIKeyItem(item); ok {
+						models, errDecode := decodeAccessKeyModelList(mNode)
+						if errDecode != nil {
+							return false, errDecode
+						}
+						if err := recordKeysNodeEntry(keyVal, true); err != nil {
+							return false, err
+						}
+						addModels(keyVal, models)
+						continue
+					}
+					for i := 0; i+1 < len(item.Content); i += 2 {
+						kNode := item.Content[i]
+						vNode := item.Content[i+1]
+						if kNode == nil || kNode.Kind != yaml.ScalarNode {
+							return false, fmt.Errorf("access.api-keys mapping key must be a string")
+						}
+						models, errDecode := decodeAccessKeyModelList(vNode)
+						if errDecode != nil {
+							return false, errDecode
+						}
+						if err := recordKeysNodeEntry(kNode.Value, true); err != nil {
+							return false, err
+						}
+						addModels(kNode.Value, models)
+					}
+				default:
+					return false, fmt.Errorf("access.api-keys entry must be a string or mapping")
+				}
+			}
+		case yaml.MappingNode:
+			for i := 0; i+1 < len(keysNode.Content); i += 2 {
+				kNode := keysNode.Content[i]
+				vNode := keysNode.Content[i+1]
+				if kNode == nil || kNode.Kind != yaml.ScalarNode {
+					return false, fmt.Errorf("access.api-keys mapping key must be a string")
+				}
+				models, errDecode := decodeAccessKeyModelList(vNode)
+				if errDecode != nil {
+					return false, errDecode
+				}
+				if err := recordKeysNodeEntry(kNode.Value, true); err != nil {
+					return false, err
+				}
+				addModels(kNode.Value, models)
+			}
+		default:
+			return false, fmt.Errorf("access.api-keys must be a list or mapping")
+		}
+	}
+
+	if modelsNode != nil && modelsNode.Tag != "!!null" {
+		if modelsNode.Kind != yaml.MappingNode {
+			return false, fmt.Errorf("access.models must be a mapping")
+		}
+		seenSectionKeys := make(map[string]struct{}, len(modelsNode.Content)/2)
+		for i := 0; i+1 < len(modelsNode.Content); i += 2 {
+			kNode := modelsNode.Content[i]
+			vNode := modelsNode.Content[i+1]
+			if kNode == nil || kNode.Kind != yaml.ScalarNode {
+				return false, fmt.Errorf("access.models key must be a string")
+			}
+			kTrimmed := strings.TrimSpace(kNode.Value)
+			if kTrimmed != "" {
+				if _, dup := seenSectionKeys[kTrimmed]; dup {
+					return false, fmt.Errorf("duplicate access.models entry %q", kTrimmed)
+				}
+				seenSectionKeys[kTrimmed] = struct{}{}
+			}
+			models, errDecode := decodeAccessKeyModelList(vNode)
+			if errDecode != nil {
+				return false, errDecode
+			}
+			addKey(kNode.Value)
+			addModels(kNode.Value, models)
+		}
+	}
+
+	if keysNode != nil || len(keyOrder) > 0 {
+		seq := &yaml.Node{Kind: yaml.SequenceNode, Tag: "!!seq", Content: make([]*yaml.Node, 0, len(keyOrder))}
+		if keysNode != nil {
+			seq.HeadComment = keysNode.HeadComment
+			seq.LineComment = keysNode.LineComment
+			seq.FootComment = keysNode.FootComment
+		}
+		for _, k := range keyOrder {
+			seq.Content = append(seq.Content, &yaml.Node{Kind: yaml.ScalarNode, Tag: "!!str", Value: k})
+		}
+		setYAMLPath(root, keysPath, seq)
+	}
+
+	if len(modelOrder) > 0 {
+		mapping := &yaml.Node{Kind: yaml.MappingNode, Tag: "!!map", Content: make([]*yaml.Node, 0, len(modelOrder)*2)}
+		if modelsNode != nil {
+			mapping.HeadComment = modelsNode.HeadComment
+			mapping.LineComment = modelsNode.LineComment
+			mapping.FootComment = modelsNode.FootComment
+		}
+		for _, k := range modelOrder {
+			models := modelsByKey[k]
+			seq := &yaml.Node{Kind: yaml.SequenceNode, Tag: "!!seq", Content: make([]*yaml.Node, 0, len(models))}
+			for _, m := range models {
+				seq.Content = append(seq.Content, &yaml.Node{Kind: yaml.ScalarNode, Tag: "!!str", Value: m})
+			}
+			mapping.Content = append(mapping.Content,
+				&yaml.Node{Kind: yaml.ScalarNode, Tag: "!!str", Value: k},
+				seq,
+			)
+		}
+		setYAMLPath(root, modelsPath, mapping)
+	} else if modelsNode != nil {
+		if !(preserveEmptyModelsMap && modelsNode.Kind == yaml.MappingNode && len(modelsNode.Content) == 0) {
+			deleteYAMLPath(root, modelsPath)
+		}
+	}
+	return true, nil
+}
+
+// SyncV8AccessModelsOnAPIKeysMutation synchronizes access.models after an
+// explicit mutation of access.api-keys (such as DELETE/PUT on access/api-keys
+// or PATCH on access without an explicit models map), preventing deleted keys
+// from surviving in access.models and resurrecting on parse while preserving
+// rules across single-key rotations.
+func SyncV8AccessModelsOnAPIKeysMutation(root, before *yaml.Node) error {
+	if root == nil || root.Kind != yaml.MappingNode {
+		return nil
+	}
+	keysNode := yamlPath(root, "access.api-keys")
+	if keysNode == nil || keysNode.Tag == "!!null" {
+		deleteYAMLPath(root, "access.models")
+		return nil
+	}
+
+	// Canonicalize access.api-keys in isolation first so stale keys in
+	// access.models cannot leak back into nextKeys.
+	isolated := &yaml.Node{Kind: yaml.MappingNode, Tag: "!!map"}
+	setYAMLPath(isolated, "access.api-keys", deepCopyNode(keysNode))
+	if _, err := normalizeAccessKeysAndModels(isolated, "access.api-keys", "access.models", false); err != nil {
+		return err
+	}
+	canonKeysNode := yamlPath(isolated, "access.api-keys")
+	inlineModelsNode := yamlPath(isolated, "access.models")
+
+	var prevKeys []string
+	if before != nil {
+		if prevNode := yamlPath(before, "access.api-keys"); prevNode != nil && prevNode.Kind == yaml.SequenceNode {
+			for _, item := range prevNode.Content {
+				if item != nil && item.Kind == yaml.ScalarNode {
+					prevKeys = append(prevKeys, strings.TrimSpace(item.Value))
+				}
+			}
+		}
+	}
+
+	var nextKeys []string
+	nextSet := make(map[string]struct{})
+	if canonKeysNode != nil && canonKeysNode.Kind == yaml.SequenceNode {
+		for _, item := range canonKeysNode.Content {
+			if item != nil && item.Kind == yaml.ScalarNode {
+				k := strings.TrimSpace(item.Value)
+				nextKeys = append(nextKeys, k)
+				if k != "" {
+					nextSet[k] = struct{}{}
+				}
+			}
+		}
+	}
+
+	modelsNode := yamlPath(root, "access.models")
+	if modelsNode != nil && modelsNode.Kind == yaml.MappingNode && len(modelsNode.Content) > 0 {
+		if len(prevKeys) > 0 && len(prevKeys) == len(nextKeys) {
+			prevSet := make(map[string]struct{}, len(prevKeys))
+			changedIdx := -1
+			changedCount := 0
+			for i := range prevKeys {
+				if prevKeys[i] != "" {
+					prevSet[prevKeys[i]] = struct{}{}
+				}
+				if prevKeys[i] != nextKeys[i] {
+					changedIdx = i
+					changedCount++
+				}
+			}
+			if changedCount == 1 && changedIdx >= 0 {
+				oldKey := prevKeys[changedIdx]
+				newKey := nextKeys[changedIdx]
+				_, stillPresent := nextSet[oldKey]
+				_, existedBefore := prevSet[newKey]
+				hasInlineNew := inlineModelsNode != nil && findMapKeyIndex(inlineModelsNode, newKey) >= 0
+				if oldKey != "" && newKey != "" && !stillPresent && !existedBefore && !hasInlineNew && findMapKeyIndex(modelsNode, newKey) < 0 {
+					for i := 0; i+1 < len(modelsNode.Content); i += 2 {
+						if modelsNode.Content[i] != nil && strings.TrimSpace(modelsNode.Content[i].Value) == oldKey {
+							modelsNode.Content[i].Value = newKey
+							break
+						}
+					}
+				}
+			}
+		}
+
+		kept := make([]*yaml.Node, 0, len(modelsNode.Content))
+		for i := 0; i+1 < len(modelsNode.Content); i += 2 {
+			kNode := modelsNode.Content[i]
+			vNode := modelsNode.Content[i+1]
