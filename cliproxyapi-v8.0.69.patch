+func matchAPIKeyModelPattern(pattern, rawModel string) bool {
+	if pattern == "" || rawModel == "" {
+		return false
+	}
+	patternBase, patternSuffix, patternHasSuffix := splitAPIKeyModelThinkingSuffix(pattern)
+	rawBase, rawSuffix, rawHasSuffix := splitAPIKeyModelThinkingSuffix(rawModel)
+
+	if patternHasSuffix {
+		if !rawHasSuffix {
+			return false
+		}
+		normalizedPatternBase := strings.TrimPrefix(patternBase, "models/")
+		normalizedPattern := normalizedPatternBase + "(" + patternSuffix + ")"
+		allowStripSlash := !strings.Contains(normalizedPatternBase, "/")
+
+		noModelsBase := strings.TrimPrefix(rawBase, "models/")
+		uncloakedBase := resolveAPIKeyCloakedClaudeModelID(noModelsBase)
+		candidates := []string{
+			rawModel,
+			noModelsBase + "(" + rawSuffix + ")",
+			uncloakedBase + "(" + rawSuffix + ")",
+		}
+		if allowStripSlash {
+			if stripped := stripProviderModelPrefix(noModelsBase); stripped != noModelsBase {
+				candidates = append(candidates,
+					stripped+"("+rawSuffix+")",
+					resolveAPIKeyCloakedClaudeModelID(stripped)+"("+rawSuffix+")",
+				)
+			}
+		}
+		for _, candidate := range candidates {
+			if candidate == "" {
+				continue
+			}
+			if matchAPIKeyModelWildcard(pattern, candidate) || matchAPIKeyModelWildcard(normalizedPattern, candidate) {
+				return true
+			}
+		}
+		return false
+	}
+
+	normalizedPattern := strings.TrimPrefix(pattern, "models/")
+	allowStripSlash := !strings.Contains(normalizedPattern, "/")
+
+	noModelsBase := strings.TrimPrefix(rawBase, "models/")
+	uncloakedBase := resolveAPIKeyCloakedClaudeModelID(noModelsBase)
+	candidates := []string{
+		rawModel,
+		rawBase,
+		noModelsBase,
+		uncloakedBase,
+	}
+	if allowStripSlash {
+		if stripped := stripProviderModelPrefix(noModelsBase); stripped != noModelsBase {
+			candidates = append(candidates, stripped, resolveAPIKeyCloakedClaudeModelID(stripped))
+		}
+	}
+	for _, candidate := range candidates {
+		if candidate == "" {
+			continue
+		}
+		if matchAPIKeyModelWildcard(pattern, candidate) || (normalizedPattern != "" && matchAPIKeyModelWildcard(normalizedPattern, candidate)) {
+			return true
+		}
+	}
+	return false
+}
+
+func splitAPIKeyModelThinkingSuffix(model string) (base, suffix string, hasSuffix bool) {
+	lastOpen := strings.LastIndex(model, "(")
+	if lastOpen <= 0 || !strings.HasSuffix(model, ")") {
+		return model, "", false
+	}
+	inner := strings.TrimSpace(model[lastOpen+1 : len(model)-1])
+	if inner == "" {
+		return model, "", false
+	}
+	return strings.TrimSpace(model[:lastOpen]), inner, true
+}
+
+func stripProviderModelPrefix(model string) string {
+	if idx := strings.LastIndex(model, "/"); idx >= 0 && idx+1 < len(model) {
+		return strings.TrimSpace(model[idx+1:])
+	}
+	return model
+}
+
+func resolveAPIKeyCloakedClaudeModelID(model string) string {
+	const prefix = "claude-fable-5-dd-"
+	if !strings.HasPrefix(model, prefix) {
+		return model
+	}
+	encoded := model[len(prefix):]
+	if encoded == "" {
+		return model
+	}
+	runes := []rune(encoded)
+	for i, j := 0, len(runes)-1; i < j; i, j = i+1, j-1 {
+		runes[i], runes[j] = runes[j], runes[i]
+	}
+	return string(runes)
+}
+
+func matchAPIKeyModelWildcard(pattern, value string) bool {
+	if pattern == "" {
+		return false
+	}
+	if !strings.Contains(pattern, "*") {
+		return pattern == value
+	}
+	parts := strings.Split(pattern, "*")
+	if prefix := parts[0]; prefix != "" {
+		if !strings.HasPrefix(value, prefix) {
+			return false
+		}
+		value = value[len(prefix):]
+	}
+	if suffix := parts[len(parts)-1]; suffix != "" {
+		if !strings.HasSuffix(value, suffix) {
+			return false
+		}
+		value = value[:len(value)-len(suffix)]
+	}
+	for i := 1; i < len(parts)-1; i++ {
+		segment := parts[i]
+		if segment == "" {
+			continue
+		}
+		idx := strings.Index(value, segment)
+		if idx < 0 {
+			return false
+		}
+		value = value[idx+len(segment):]
+	}
+	return true
+}
