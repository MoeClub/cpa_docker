+func parseAPIKeyModelRules(rules []string) (allowPatterns, denyPatterns []string) {
+	for _, item := range rules {
+		trimmed := strings.ToLower(strings.TrimSpace(item))
+		if trimmed == "" {
+			continue
+		}
+		if strings.HasPrefix(trimmed, "!") {
+			if deny := strings.TrimSpace(trimmed[1:]); deny != "" {
+				denyPatterns = append(denyPatterns, deny)
+			}
+			continue
+		}
+		allowPatterns = append(allowPatterns, trimmed)
+	}
+	return allowPatterns, denyPatterns
+}
+
+// IsAPIKeyRestricted reports whether apiKey has at least one active allow or
+// deny model rule configured in APIKeyModels.
+func (c *SDKConfig) IsAPIKeyRestricted(apiKey string) bool {
+	if c == nil || len(c.APIKeyModels) == 0 {
+		return false
+	}
+	apiKey = strings.TrimSpace(apiKey)
+	if apiKey == "" {
+		return false
+	}
+	allowed, exists := c.APIKeyModels[apiKey]
+	if !exists || len(allowed) == 0 {
+		return false
+	}
+	allowPatterns, denyPatterns := parseAPIKeyModelRules(allowed)
+	return len(allowPatterns) > 0 || len(denyPatterns) > 0
