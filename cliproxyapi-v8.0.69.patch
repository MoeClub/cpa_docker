+func TestParseConfigBytes_AccessAPIKeyModelsInlineAndSection(t *testing.T) {
+	raw := []byte(`config-version: 8
+access:
+  api-keys:
+    - "sk-unrestricted"
+    - "sk-inline-Empty": []
+    - "sk-inline":
+        - "deepseek-v4.1-flash"
+        - "glm-5.3"
+    - api-key: "sk-structured"
+      models:
+        - "kimi-*"
+  models:
