+func (r *ModelRegistry) clientAntigravityModelEnumLocked(modelID, provider, excludeClientID string) string {
+	if r == nil || modelID == "" {
+		return ""
+	}
+	bestClientID := ""
+	bestEnum := ""
+	for cid, infos := range r.clientModelInfos {
+		if cid == excludeClientID || infos == nil {
+			continue
+		}
+		if provider != "" && r.clientProviders[cid] != provider {
+			continue
+		}
+		info := infos[modelID]
+		if info == nil {
+			continue
+		}
+		enumVal := strings.TrimSpace(info.AntigravityModelEnum)
+		if enumVal == "" {
+			continue
+		}
+		if bestEnum == "" || cid < bestClientID {
+			bestClientID = cid
+			bestEnum = enumVal
+		}
+	}
+	return bestEnum
+}
