+// EffectiveAccessDenyEfforts resolves effective upstream thinking efforts and
+// budgets that baseModel will execute with for requestedEfforts (including
+// CodexLevelMap, ultra/max/xhigh clamping, numeric budget conversion, and
+// model default_level when requestedEfforts is empty), so explicit "!" deny
+// rules cannot be bypassed via effort synonyms, budgets, or omitted defaults.
+func EffectiveAccessDenyEfforts(baseModel string, requestedEfforts []string) []string {
+	lookupModel := strings.TrimSpace(baseModel)
+	modelInfo := registry.LookupModelInfo(lookupModel)
+	if modelInfo == nil {
+		trimmed := strings.TrimPrefix(lookupModel, "models/")
+		if idx := strings.LastIndex(trimmed, "/"); idx >= 0 && idx+1 < len(trimmed) {
+			trimmed = strings.TrimSpace(trimmed[idx+1:])
+		}
+		if trimmed != "" && trimmed != lookupModel {
+			modelInfo = registry.LookupModelInfo(trimmed)
+		}
+	}
+
+	var out []string
+	add := func(val string) {
+		val = strings.ToLower(strings.TrimSpace(val))
+		if val == "" {
+			return
+		}
+		for _, existing := range out {
+			if existing == val {
+				return
+			}
+		}
+		out = append(out, val)
+	}
+
+	if len(requestedEfforts) == 0 {
+		if modelInfo != nil && modelInfo.Thinking != nil {
+			if def := strings.ToLower(strings.TrimSpace(modelInfo.Thinking.DefaultLevel)); def != "" {
+				add(def)
+				if mapped, ok := mapConfiguredCodexLevel(ThinkingLevel(def), modelInfo); ok {
+					add(string(mapped))
+				}
+			}
+		}
+		return out
+	}
+
+	for _, raw := range requestedEfforts {
+		e := strings.ToLower(strings.TrimSpace(raw))
+		switch e {
+		case "":
+			continue
+		case "disabled", "persistent":
+			e = "none"
+		}
+		add(e)
+
+		if n, err := strconv.Atoi(e); err == nil && n > 0 {
+			if lvl, ok := ConvertBudgetToLevel(n); ok && lvl != "" {
+				add(lvl)
+				if modelInfo != nil && modelInfo.Thinking != nil {
+					add(string(clampLevel(ThinkingLevel(lvl), modelInfo, "")))
+				}
+			}
+			if modelInfo != nil && modelInfo.Thinking != nil {
+				clamped := clampBudget(n, modelInfo, "")
+				if clamped > 0 {
+					add(strconv.Itoa(clamped))
+					if lvl, ok := ConvertBudgetToLevel(clamped); ok && lvl != "" {
+						add(lvl)
+					}
+				}
+			}
+			continue
+		}
+
+		if modelInfo == nil || modelInfo.Thinking == nil {
+			if e == string(LevelUltra) {
+				add(string(LevelXHigh))
+				add(string(LevelMax))
+			}
+			continue
+		}
+
+		if e == "auto" {
+			if !modelInfo.Thinking.DynamicAllowed {
+				mid := convertAutoToMidRange(ThinkingConfig{Mode: ModeAuto, Budget: -1}, modelInfo.Thinking, "", modelInfo.ID)
+				if mid.Mode == ModeLevel && mid.Level != "" {
+					add(string(clampLevel(mid.Level, modelInfo, "")))
+				} else if mid.Mode == ModeBudget && mid.Budget > 0 {
+					add(strconv.Itoa(mid.Budget))
+				}
+			}
+			continue
+		}
+
+		lvl := ThinkingLevel(e)
+		if mapped, ok := mapConfiguredCodexLevel(lvl, modelInfo); ok {
+			add(string(mapped))
+		}
+		if hi := mapConfiguredHighIntent(lvl, modelInfo); hi != "" && isLevelSupported(string(hi), modelInfo.Thinking.Levels) {
+			add(string(hi))
+		}
+		if clamped := clampLevel(lvl, modelInfo, ""); clamped != "" && isLevelSupported(string(clamped), modelInfo.Thinking.Levels) {
+			add(string(clamped))
+		}
+		if detectModelCapability(modelInfo) == CapabilityBudgetOnly {
+			if b, ok := ConvertLevelToBudget(e); ok && b > 0 {
+				clamped := clampBudget(b, modelInfo, "")
+				if clamped > 0 {
+					add(strconv.Itoa(clamped))
+				}
+			}
+		}
+	}
+	return out
+}
