@@ -47,9 +47,21 @@ var (
 	errAuthFileNotFound        = errors.New("auth file not found")
 	errPluginVirtualAuth       = errors.New("plugin virtual auth cannot be modified directly; edit or delete the source auth file")
 	newCodexOAuthService       = func(cfg *config.Config) codexOAuthService { return codex.NewCodexAuth(cfg) }
-	newAntigravityOAuthService = func(cfg *config.Config) antigravityOAuthService { return antigravity.NewAntigravityAuth(cfg, nil) }
+	newAntigravityOAuthService = newPKCEAntigravityOAuthService
 )
 
+// newPKCEAntigravityOAuthService returns the service used by the management login.
+// Codes are generated per service, and one service spans the whole flow, so the
+// challenge on the authorization URL always matches the verifier on the exchange.
+func newPKCEAntigravityOAuthService(cfg *config.Config) antigravityOAuthService {
+	codes, errPKCE := antigravity.GeneratePKCECodes()
+	if errPKCE != nil {
+		log.Warnf("antigravity: PKCE unavailable, logging in without a code challenge: %v", errPKCE)
+		return antigravity.NewAntigravityAuth(cfg, nil)
+	}
+	return antigravity.NewAntigravityAuthWithPKCE(cfg, nil, codes)
+}
