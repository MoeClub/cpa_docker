+func (c *SDKConfig) IsAPIKeyModelExplicitlyDenied(apiKey, modelName string) bool {
+	if c == nil || len(c.APIKeyModels) == 0 {
+		return false
+	}
+	apiKey = strings.TrimSpace(apiKey)
+	if apiKey == "" {
+		return false
+	}
+	allowed, exists := c.APIKeyModels[apiKey]
+	if !exists || len(allowed) == 0 {
+		return false
+	}
+	_, denyPatterns := parseAPIKeyModelRules(allowed)
+	if len(denyPatterns) == 0 {
+		return false
+	}
+	rawModel := strings.ToLower(strings.TrimSpace(modelName))
+	if rawModel == "" {
+		return false
+	}
+	for _, denyPattern := range denyPatterns {
+		if matchAPIKeyModelPattern(denyPattern, rawModel) {
+			return true
+		}
+	}
+	return false
