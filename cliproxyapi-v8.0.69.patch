+type prevalidatedModelAccessContextKey struct{}
+
+// WithPrevalidatedModelAccess marks ctx as having already validated the client's
+// requested public model ID before rewriting into an internal carrier model
+// (for example /v1/images/generations using an internal Responses carrier).
+func WithPrevalidatedModelAccess(ctx context.Context) context.Context {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	return context.WithValue(ctx, prevalidatedModelAccessContextKey{}, true)
+}
+
+func isModelAccessPrevalidated(ctx context.Context) bool {
+	if ctx == nil {
+		return false
+	}
+	ok, _ := ctx.Value(prevalidatedModelAccessContextKey{}).(bool)
