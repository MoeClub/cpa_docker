+// FilterResponseReasoningLevels prunes supported_reasoning_levels and reconciles
+// default_reasoning_level on each Codex catalog entry using isAllowed(slug+"("+effort+")").
+// When a model originally advertised reasoning levels and every one of them is
+// denied while the unsuffixed model is also denied, the model entry is omitted.
+func FilterResponseReasoningLevels(payload map[string]any, isAllowed func(modelName string) bool) map[string]any {
+	if payload == nil || isAllowed == nil {
+		return payload
+	}
+	rawModels, ok := payload["models"].([]map[string]any)
+	if !ok || len(rawModels) == 0 {
+		return payload
+	}
+	filteredModels := make([]map[string]any, 0, len(rawModels))
+	for _, entry := range rawModels {
+		if entry == nil {
+			continue
+		}
+		slug, _ := entry["slug"].(string)
+		slug = strings.TrimSpace(slug)
+		if slug == "" {
+			if id, okID := entry["id"].(string); okID {
+				slug = strings.TrimSpace(id)
+			}
+		}
+		if slug == "" {
+			filteredModels = append(filteredModels, entry)
+			continue
+		}
+		rawLevels, hasLevels := entry["supported_reasoning_levels"].([]any)
+		if !hasLevels || len(rawLevels) == 0 {
+			if isAllowed(slug) {
+				filteredModels = append(filteredModels, entry)
+			}
+			continue
+		}
+		keptLevels := make([]any, 0, len(rawLevels))
+		keptSet := make(map[string]struct{}, len(rawLevels))
+		firstLevel := ""
+		firstNonNone := ""
+		hasMedium := false
+		for _, item := range rawLevels {
+			itemMap, okMap := item.(map[string]any)
+			if !okMap {
+				continue
+			}
+			effort, _ := itemMap["effort"].(string)
+			effort = strings.TrimSpace(effort)
+			if effort == "" {
+				continue
+			}
+			if !isAllowed(slug + "(" + effort + ")") {
+				continue
+			}
+			keptLevels = append(keptLevels, itemMap)
+			keptSet[effort] = struct{}{}
+			if firstLevel == "" {
+				firstLevel = effort
+			}
+			if firstNonNone == "" && effort != "none" {
+				firstNonNone = effort
+			}
+			if effort == "medium" {
+				hasMedium = true
+			}
+		}
+		if len(keptLevels) == 0 {
+			if !isAllowed(slug) {
+				continue
+			}
+			cloned := cloneCodexClientModelMap(entry)
+			cloned["supported_reasoning_levels"] = []any{}
+			delete(cloned, "default_reasoning_level")
+			filteredModels = append(filteredModels, cloned)
+			continue
+		}
+		if len(keptLevels) == len(rawLevels) {
+			filteredModels = append(filteredModels, entry)
+			continue
+		}
+		cloned := cloneCodexClientModelMap(entry)
+		cloned["supported_reasoning_levels"] = keptLevels
+		currentDefault, _ := cloned["default_reasoning_level"].(string)
+		currentDefault = strings.TrimSpace(currentDefault)
+		if _, okDefault := keptSet[currentDefault]; !okDefault {
+			switch {
+			case hasMedium:
+				cloned["default_reasoning_level"] = "medium"
+			case firstNonNone != "":
+				cloned["default_reasoning_level"] = firstNonNone
+			default:
+				cloned["default_reasoning_level"] = firstLevel
+			}
+		}
+		filteredModels = append(filteredModels, cloned)
+	}
+	payload["models"] = filteredModels
+	return payload
+}
