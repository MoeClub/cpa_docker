+		return nil
+	}
+	apiKey := s.handlers.ClientAPIKeyFromGin(c)
+	if !cfg.IsAPIKeyRestricted(apiKey) {
+		return nil
+	}
+	if cfg.IsAPIKeyModelExplicitlyDenied(apiKey, "codex-alpha-search") {
+		return s.handlers.ValidateAPIKeyModelAccessForGin(c, "codex-alpha-search")
+	}
+	if cfg.IsAPIKeyModelCatalogVisible(apiKey, "codex-alpha-search") {
+		return nil
+	}
+	reg := registry.GetGlobalRegistry()
+	for _, info := range reg.GetAvailableModelInfos() {
+		if info == nil || strings.TrimSpace(info.ID) == "" {
+			continue
+		}
+		for _, provider := range reg.GetModelProviders(info.ID) {
+			if strings.EqualFold(strings.TrimSpace(provider), "codex") {
+				if cfg.IsAPIKeyModelCatalogVisible(apiKey, info.ID) {
+					return nil
+				}
+				break
+			}
+		}
+	}
+	for _, fallbackCodexModel := range []string{"gpt-5-codex", "gpt-5.3-codex", "gpt-5.4"} {
+		if cfg.IsAPIKeyModelCatalogVisible(apiKey, fallbackCodexModel) {
+			return nil
+		}
+	}
+	return s.handlers.ValidateAPIKeyModelAccessForGin(c, "codex-alpha-search")
+}
