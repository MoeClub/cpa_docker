+func TestResponsesWebsocketMultiTurnHonorsInheritedEffortAndBlocksEscalation(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+
+	executor := &homeResponsesWebsocketExecutor{
+		responses: [][]byte{
+			[]byte(`{"type":"response.completed","response":{"id":"resp-turn-1","output":[{"type":"message","role":"assistant","content":[{"type":"output_text","text":"ok1"}]}]}}`),
+			[]byte(`{"type":"response.completed","response":{"id":"resp-turn-2","output":[{"type":"message","role":"assistant","content":[{"type":"output_text","text":"ok2"}]}]}}`),
+		},
+	}
+	manager := coreauth.NewManager(nil, &coreauth.RoundRobinSelector{}, nil)
+	manager.RegisterExecutor(executor)
+	authRec := &coreauth.Auth{
+		ID:       "ws-effort-test-auth",
+		Provider: "codex",
+		Status:   coreauth.StatusActive,
+	}
+	if _, err := manager.Register(context.Background(), authRec); err != nil {
+		t.Fatalf("manager.Register: %v", err)
+	}
+	const wsModel = "ws-effort-codex-model"
+	registry.GetGlobalRegistry().RegisterClient(authRec.ID, "codex", []*registry.ModelInfo{
+		{
+			ID:                         wsModel,
+			Type:                       "codex",
+			SupportConfigurationUpdate: true,
+			Thinking: &registry.ThinkingSupport{
+				Levels:       []string{"low", "medium", "high", "xhigh"},
+				DefaultLevel: "high",
+			},
+		},
+	})
+	manager.RefreshSchedulerEntry(authRec.ID)
+	t.Cleanup(func() {
+		registry.GetGlobalRegistry().UnregisterClient(authRec.ID)
+	})
+
+	cfg := &sdkconfig.SDKConfig{
+		APIKeys: []string{"sk-ws-low"},
+		APIKeyModels: map[string][]string{
+			"sk-ws-low": {wsModel + "(low)"},
+		},
+	}
+	h := NewOpenAIResponsesAPIHandler(apihandlers.NewBaseAPIHandlers(cfg, manager))
+	router := gin.New()
+	withSimulatedAPIKeyMiddleware(router)
+	router.GET("/v1/responses/ws", h.ResponsesWebsocket)
+	server := httptest.NewServer(router)
+	defer server.Close()
+
+	wsURL := "ws" + strings.TrimPrefix(server.URL, "http") + "/v1/responses/ws"
+	headers := http.Header{"Authorization": []string{"Bearer sk-ws-low"}}
+	conn, _, errDial := websocket.DefaultDialer.Dial(wsURL, headers)
+	if errDial != nil {
+		t.Fatalf("dial websocket: %v", errDial)
+	}
+	defer func() { _ = conn.Close() }()
+
+	sendAndReadType := func(step string, msg string) (string, []byte) {
+		t.Helper()
+		if err := conn.WriteMessage(websocket.TextMessage, []byte(msg)); err != nil {
+			t.Fatalf("%s write: %v", step, err)
+		}
+		_, payload, err := conn.ReadMessage()
+		if err != nil {
+			t.Fatalf("%s read: %v", step, err)
+		}
+		return ojson.GetBytesNoCopy(payload, "type").String(), payload
+	}
+
+	// 1. Root response.create WITH allowed reasoning.effort="low" succeeds.
+	if evType, raw := sendAndReadType("turn1", `{"type":"response.create","model":"`+wsModel+`","reasoning":{"effort":"low"},"input":[{"type":"message","role":"user","content":"hello"}]}`); evType != wsEventTypeCompleted {
+		t.Fatalf("turn1 event = %q, want %q: %s", evType, wsEventTypeCompleted, raw)
+	}
+
+	// 2. Incremental response.append omitting model and reasoning inherits authorized "low" effort and preserves reasoning on HTTP fallback!
+	if evType, raw := sendAndReadType("turn2 append", `{"type":"response.append","input":[{"type":"message","role":"user","content":"follow up"}]}`); evType != wsEventTypeCompleted {
+		t.Fatalf("turn2 append event = %q, want %q: %s", evType, wsEventTypeCompleted, raw)
+	}
+	executor.mu.Lock()
+	if len(executor.payloads) < 2 {
+		executor.mu.Unlock()
+		t.Fatalf("executor payloads len = %d, want >= 2", len(executor.payloads))
+	}
+	turn2Effort := ojson.GetBytesNoCopy(executor.payloads[1], "reasoning.effort").String()
+	executor.mu.Unlock()
+	if turn2Effort != "low" {
+		t.Fatalf("HTTP-fallback normalized turn2 reasoning.effort = %q, want low", turn2Effort)
+	}
+
+	// 3. Escalation via configuration_update to xhigh on response.append is blocked!
+	if evType, raw := sendAndReadType("turn3 escalate", `{"type":"response.append","input":[{"type":"configuration_update","reasoning":{"effort":"xhigh"}},{"type":"message","role":"user","content":"escalate"}]}`); evType != "error" {
+		t.Fatalf("turn3 escalate event = %q, want error: %s", evType, raw)
+	}
+
+	// 4. Brand-new root response.create omitting reasoning.effort must NOT inherit previous turn's effort!
+	if evType, raw := sendAndReadType("turn4 bare root", `{"type":"response.create","model":"`+wsModel+`","input":[{"type":"message","role":"user","content":"fresh root"}]}`); evType != "error" {
+		t.Fatalf("turn4 bare root event = %q, want error: %s", evType, raw)
+	}
+}
