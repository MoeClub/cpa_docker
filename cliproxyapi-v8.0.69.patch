+func TestAPIKeyModelCatalogVisibilityAndExplicitDeny(t *testing.T) {
+	cfg := &Config{
+		SDKConfig: SDKConfig{
+			APIKeyModels: map[string][]string{
+				"sk-low-only":   {"gpt-5.4(low)"},
+				"sk-no-xhigh":   {"*", "!gpt-5.4(xhigh)"},
+				"sk-deny-base":  {"*", "!gpt-5.4"},
+				"sk-deny-all":   {"!*"},
+				"sk-only-other": {"claude-sonnet-4-5"},
+			},
+		},
+	}
+
+	// Suffix-pinned key must still see base model gpt-5.4 in /v1/models catalog!
+	if !cfg.IsAPIKeyModelCatalogVisible("sk-low-only", "gpt-5.4") {
+		t.Fatal("expected base model gpt-5.4 to remain catalog-visible when gpt-5.4(low) is allowed")
+	}
+	if cfg.IsAPIKeyModelCatalogVisible("sk-low-only", "claude-sonnet-4-5") {
+		t.Fatal("expected unrelated model to be hidden from sk-low-only catalog")
+	}
+
+	// Denying only one suffix (!gpt-5.4(xhigh)) keeps base model visible, whereas !gpt-5.4 hides it.
+	if !cfg.IsAPIKeyModelCatalogVisible("sk-no-xhigh", "gpt-5.4") {
+		t.Fatal("expected gpt-5.4 to remain catalog-visible when only !gpt-5.4(xhigh) is denied")
+	}
+	if cfg.IsAPIKeyModelCatalogVisible("sk-deny-base", "gpt-5.4") {
+		t.Fatal("expected !gpt-5.4 to hide gpt-5.4 from catalog")
+	}
+	if cfg.IsAPIKeyModelCatalogVisible("sk-deny-all", "gpt-5.4") {
+		t.Fatal("expected !* to hide all models from catalog")
+	}
+
+	if !cfg.IsAPIKeyModelExplicitlyDenied("sk-no-xhigh", "gpt-5.4(xhigh)") {
+		t.Fatal("expected gpt-5.4(xhigh) to be explicitly denied for sk-no-xhigh")
+	}
+	if cfg.IsAPIKeyModelExplicitlyDenied("sk-no-xhigh", "gpt-5.4(low)") {
+		t.Fatal("expected gpt-5.4(low) not to be explicitly denied for sk-no-xhigh")
+	}
+	if cfg.IsAPIKeyModelExplicitlyDenied("sk-only-other", "gpt-5.4") {
+		t.Fatal("implicit non-match on allowlist must not report as explicit !deny")
+	}
+}
