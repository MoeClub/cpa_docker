+func parseStructuredAccessAPIKeyItem(node *yaml.Node) (string, *yaml.Node, bool) {
+	if node == nil || node.Kind != yaml.MappingNode || len(node.Content) == 0 {
+		return "", nil, false
+	}
+	var keyVal string
+	var hasKeyField bool
+	var modelsNode *yaml.Node
+	for i := 0; i+1 < len(node.Content); i += 2 {
+		k := node.Content[i]
+		v := node.Content[i+1]
+		if k == nil {
+			return "", nil, false
+		}
+		switch k.Value {
+		case "api-key", "key":
+			if v == nil || v.Kind != yaml.ScalarNode || v.Tag == "!!null" {
+				return "", nil, false
+			}
+			keyVal = v.Value
+			hasKeyField = true
+		case "models":
+			modelsNode = v
+		default:
+			return "", nil, false
+		}
+	}
+	if !hasKeyField {
+		return "", nil, false
+	}
+	return keyVal, modelsNode, true
