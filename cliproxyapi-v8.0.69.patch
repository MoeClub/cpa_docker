+		t.Fatalf("ParseNumericSuffix(\" 8192 \") = (%d, %v), want (8192, true)", budget, ok)
+	}
+	if mode, ok := thinking.ParseSpecialSuffix(" disabled "); !ok || mode != thinking.ModeNone {
+		t.Fatalf("ParseSpecialSuffix(\" disabled \") = (%v, %v), want (ModeNone, true)", mode, ok)
+	}
