+func TestVideosRetrieveAndContentHonorSora2AllowlistAndIsolateTenants(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	resetVideoAuthBindingsForTest(t)
+
+	executor := &videoAuthCaptureExecutor{requestID: "vid-sora-bound-1"}
+	manager := coreauth.NewManager(nil, &coreauth.RoundRobinSelector{}, nil)
+	manager.RegisterExecutor(executor)
+	authRec := &coreauth.Auth{
+		ID:       "xai-sora-test-auth",
+		Provider: "xai",
+		Status:   coreauth.StatusActive,
+	}
+	if _, err := manager.Register(context.Background(), authRec); err != nil {
+		t.Fatalf("manager.Register: %v", err)
+	}
+	models := []*registry.ModelInfo{{ID: defaultXAIVideosModel}, {ID: defaultOpenAIVideosModel}}
+	registry.GetGlobalRegistry().RegisterClient(authRec.ID, authRec.Provider, models)
+	manager.RefreshSchedulerEntry(authRec.ID)
+	t.Cleanup(func() {
+		registry.GetGlobalRegistry().UnregisterClient(authRec.ID)
+	})
+
+	cfg := &sdkconfig.SDKConfig{
+		APIKeys: []string{"sk-sora-a", "sk-sora-b", "sk-deny-sora", "sk-no-video"},
+		APIKeyModels: map[string][]string{
+			"sk-sora-a":    {"sora-2"},
+			"sk-sora-b":    {"sora-2"},
+			"sk-deny-sora": {"*", "!sora-2"},
+			"sk-no-video":  {"gpt-5.4"},
+		},
+	}
+	handler := NewOpenAIAPIHandler(apihandlers.NewBaseAPIHandlers(cfg, manager))
+	router := gin.New()
+	withSimulatedAPIKeyMiddleware(router)
+	router.POST("/v1/videos", handler.VideosCreate)
+	router.GET("/v1/videos/:video_id", handler.VideosRetrieve)
+
+	doVideoReq := func(method, url, apiKey, body string) *httptest.ResponseRecorder {
+		t.Helper()
+		var reader *strings.Reader
+		if body != "" {
+			reader = strings.NewReader(body)
+		} else {
+			reader = strings.NewReader("")
+		}
+		req := httptest.NewRequest(method, url, reader)
+		if body != "" {
+			req.Header.Set("Content-Type", "application/json")
+		}
+		req.Header.Set("Authorization", "Bearer "+apiKey)
+		rec := httptest.NewRecorder()
+		router.ServeHTTP(rec, req)
+		return rec
+	}
+
+	// 1. sk-sora-a creates video via sora-2 and retrieves it (no 403 from internal grok-imagine-video alias).
+	createRec := doVideoReq(http.MethodPost, "/v1/videos", "sk-sora-a", `{"model":"sora-2","prompt":"ocean waves"}`)
+	if createRec.Code != http.StatusOK {
+		t.Fatalf("VideosCreate(sk-sora-a) status=%d want=200 body=%s", createRec.Code, createRec.Body.String())
+	}
+	videoID := ojson.GetBytesNoCopy(createRec.Body.Bytes(), "id").String()
+	if videoID == "" {
+		videoID = "vid-sora-bound-1"
+	}
+
+	retrieveOwner := doVideoReq(http.MethodGet, "/v1/videos/"+videoID, "sk-sora-a", "")
+	if retrieveOwner.Code != http.StatusOK {
+		t.Fatalf("VideosRetrieve(owner sk-sora-a) status=%d want=200 body=%s", retrieveOwner.Code, retrieveOwner.Body.String())
+	}
+
+	// 2. Tenant isolation: sk-sora-b cannot retrieve sk-sora-a's bound video_id even though both allow sora-2.
+	retrieveOther := doVideoReq(http.MethodGet, "/v1/videos/"+videoID, "sk-sora-b", "")
+	if retrieveOther.Code != http.StatusForbidden {
+		t.Fatalf("VideosRetrieve(other tenant sk-sora-b) status=%d want=403 body=%s", retrieveOther.Code, retrieveOther.Body.String())
+	}
+
+	// 3. Unbound video_id (e.g. after restart/TTL expiry):
+	//    - sk-sora-a (["sora-2"]) succeeds via alias fallback
+	//    - sk-deny-sora (["*", "!sora-2"]) ALSO succeeds via grok-imagine-video without false-deny
+	//    - sk-no-video (["gpt-5.4"]) is blocked with 403
+	if rec := doVideoReq(http.MethodGet, "/v1/videos/vid-unbound-999", "sk-sora-a", ""); rec.Code != http.StatusOK {
+		t.Fatalf("unbound VideosRetrieve(sk-sora-a) status=%d want=200 body=%s", rec.Code, rec.Body.String())
+	}
+	if rec := doVideoReq(http.MethodGet, "/v1/videos/vid-unbound-999", "sk-deny-sora", ""); rec.Code != http.StatusOK {
+		t.Fatalf("unbound VideosRetrieve(sk-deny-sora) status=%d want=200 body=%s", rec.Code, rec.Body.String())
+	}
+	if rec := doVideoReq(http.MethodGet, "/v1/videos/vid-unbound-999", "sk-no-video", ""); rec.Code != http.StatusForbidden {
+		t.Fatalf("unbound VideosRetrieve(sk-no-video) status=%d want=403 body=%s", rec.Code, rec.Body.String())
+	}
+}
