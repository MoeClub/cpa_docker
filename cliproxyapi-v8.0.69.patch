+func TestNormalizeConfigLayoutProjectsPlainAPIKeysAndRejectsDuplicates(t *testing.T) {
+	raw := []byte(`config-version: 8
+access:
+  api-keys:
+    - "sk-plain"
+    - "sk-inline":
+        - "gpt-5.4(low)"
+  models:
+    "sk-models-only":
+      - "kimi-*"
+`)
+	normalized, _, err := NormalizeConfigLayout(raw, true)
+	if err != nil {
+		t.Fatalf("NormalizeConfigLayout() error = %v", err)
+	}
+	var doc struct {
+		Access struct {
+			APIKeys []string            `yaml:"api-keys"`
+			Models  map[string][]string `yaml:"models"`
+		} `yaml:"access"`
+	}
+	if err := yaml.Unmarshal(normalized, &doc); err != nil {
+		t.Fatalf("projected access.api-keys is not []string: %v\n%s", err, normalized)
+	}
+	wantKeys := []string{"sk-plain", "sk-inline", "sk-models-only"}
+	if !slices.Equal(doc.Access.APIKeys, wantKeys) {
+		t.Fatalf("projected access.api-keys = %v, want %v", doc.Access.APIKeys, wantKeys)
+	}
+	if !slices.Equal(doc.Access.Models["sk-inline"], []string{"gpt-5.4(low)"}) {
+		t.Fatalf("projected access.models[sk-inline] = %v, want [gpt-5.4(low)]", doc.Access.Models["sk-inline"])
+	}
+
+	dupCases := []struct {
+		name string
+		yaml string
+	}{
+		{
+			name: "duplicate inline api-keys",
+			yaml: "config-version: 8\naccess:\n  api-keys:\n    - \"sk-dup\":\n        - \"gpt-5.4\"\n    - \"sk-dup\":\n        - \"kimi-k2.5\"\n",
+		},
+		{
+			name: "duplicate scalar and inline api-keys",
+			yaml: "config-version: 8\naccess:\n  api-keys:\n    - \"sk-dup\"\n    - \"sk-dup\":\n        - \"kimi-k2.5\"\n",
+		},
+		{
+			name: "duplicate keys in access.models",
+			yaml: "config-version: 8\naccess:\n  api-keys:\n    - \"sk-dup\"\n  models:\n    \"sk-dup\": [\"gpt-5.4\"]\n    \" sk-dup \": [\"kimi-k2.5\"]\n",
+		},
+	}
+	for _, tc := range dupCases {
+		t.Run(tc.name, func(t *testing.T) {
+			if err := ValidateV8Config([]byte(tc.yaml)); err == nil {
+				t.Fatalf("ValidateV8Config() unexpectedly accepted %s", tc.name)
+			}
+		})
+	}
+}
