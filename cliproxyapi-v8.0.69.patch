+func TestConfigV8AccessAPIKeysDeleteAndRotateSyncsAccessModels(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	path := filepath.Join(t.TempDir(), "config.yaml")
+	raw := `config-version: 8
+access:
+  api-keys:
+    - "sk-keep"
+    - "sk-revoke":
+        - "glm-5.3"
+    - "sk-rotate":
+        - "kimi-*"
+`
+	if err := os.WriteFile(path, []byte(raw), 0600); err != nil {
+		t.Fatal(err)
+	}
+	cfg, err := config.LoadConfig(path)
+	if err != nil {
+		t.Fatalf("LoadConfig: %v", err)
+	}
+	h := &Handler{cfg: cfg, configFilePath: path}
+	h.SetConfigReloadHook(func(_ context.Context, next *config.Config) {
+		h.cfg = next
+	})
+
+	router := gin.New()
+	router.GET("/v8/management/config", h.ConfigV8)
+	router.GET("/v8/management/config/*path", h.ConfigV8)
+	router.PATCH("/v8/management/config", h.ConfigV8)
+	router.PATCH("/v8/management/config/*path", h.ConfigV8)
+	router.PUT("/v8/management/config/*path", h.ConfigV8)
+	router.DELETE("/v8/management/config/*path", h.ConfigV8)
+
+	doReq := func(method, url, body string, wantStatus int) *httptest.ResponseRecorder {
+		t.Helper()
+		rec := httptest.NewRecorder()
+		req := httptest.NewRequest(method, url, strings.NewReader(body))
+		if body != "" {
+			req.Header.Set("Content-Type", "application/json")
+		}
+		router.ServeHTTP(rec, req)
+		if rec.Code != wantStatus {
+			t.Fatalf("%s %s status=%d want=%d body=%s", method, url, rec.Code, wantStatus, rec.Body.String())
+		}
+		return rec
+	}
+
+	// 1. GET /v8/management/config/access/api-keys projects plain []string even with inline rules.
+	getKeysRec := doReq(http.MethodGet, "/v8/management/config/access/api-keys", "", http.StatusOK)
+	var keysList []string
+	if err := json.Unmarshal(getKeysRec.Body.Bytes(), &keysList); err != nil {
+		t.Fatalf("unmarshal api-keys list: %v (body=%s)", err, getKeysRec.Body.String())
+	}
+	if !slices.Equal(keysList, []string{"sk-keep", "sk-revoke", "sk-rotate"}) {
+		t.Fatalf("GET access/api-keys = %v, want [sk-keep sk-revoke sk-rotate]", keysList)
+	}
+
+	// 2. PUT /v8/management/config/access/api-keys removing "sk-revoke" also prunes access.models["sk-revoke"]!
+	doReq(http.MethodPut, "/v8/management/config/access/api-keys", `["sk-keep","sk-rotate"]`, http.StatusOK)
+	afterDelete, err := config.LoadConfig(path)
+	if err != nil {
+		t.Fatalf("LoadConfig after PUT delete: %v", err)
+	}
+	if slices.Contains(afterDelete.APIKeys, "sk-revoke") {
+		t.Fatalf("revoked key resurrected in APIKeys after V8 PUT: %v", afterDelete.APIKeys)
+	}
+	if _, exists := afterDelete.APIKeyModels["sk-revoke"]; exists {
+		t.Fatalf("revoked key rules remained in APIKeyModels: %v", afterDelete.APIKeyModels)
+	}
+
+	// 3. PATCH /v8/management/config/access rotating "sk-rotate" -> "sk-rotated" migrates its model restriction.
+	doReq(http.MethodPatch, "/v8/management/config/access", `{"api-keys":["sk-keep","sk-rotated"]}`, http.StatusOK)
+	afterRotate, err := config.LoadConfig(path)
+	if err != nil {
+		t.Fatalf("LoadConfig after PATCH rotate: %v", err)
+	}
+	if !slices.Equal(afterRotate.APIKeys, []string{"sk-keep", "sk-rotated"}) {
+		t.Fatalf("APIKeys after rotate = %v, want [sk-keep sk-rotated]", afterRotate.APIKeys)
+	}
+	if !afterRotate.IsAPIKeyModelAllowed("sk-rotated", "kimi-k2.5") || afterRotate.IsAPIKeyModelAllowed("sk-rotated", "gpt-5.4") {
+		t.Fatalf("sk-rotated did not inherit kimi-* restriction: %v", afterRotate.APIKeyModels)
+	}
+
+	// 4. DELETE /v8/management/config/access/api-keys clears access.models so no revoked keys resurrect!
+	doReq(http.MethodDelete, "/v8/management/config/access/api-keys", "", http.StatusOK)
+	afterDeleteAll, err := config.LoadConfig(path)
+	if err != nil {
+		t.Fatalf("LoadConfig after DELETE access/api-keys: %v", err)
+	}
+	if len(afterDeleteAll.APIKeys) != 0 || len(afterDeleteAll.APIKeyModels) != 0 {
+		t.Fatalf("after DELETE access/api-keys, APIKeys=%v APIKeyModels=%v, want both empty", afterDeleteAll.APIKeys, afterDeleteAll.APIKeyModels)
+	}
+}
