+func normalizeAntigravityModelEnum(enum string) string {
+	enum = strings.TrimSpace(enum)
+	if enum == "" || len(enum) > antigravityMaxModelIDBytes {
+		return ""
+	}
+	for _, char := range enum {
+		if (char >= 'A' && char <= 'Z') || (char >= '0' && char <= '9') || char == '_' || char == '-' || char == '.' {
+			continue
+		}
+		return ""
+	}
+	return enum
