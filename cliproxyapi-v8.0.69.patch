+}
+
+// IsModelAllowedForContext reports whether the authenticated client key in ctx may access modelName.
+func (h *BaseAPIHandler) IsModelAllowedForContext(ctx context.Context, modelName string) bool {
+	if h == nil || isModelAccessPrevalidated(ctx) {
+		return true
+	}
+	cfg := h.CurrentConfig()
+	if cfg == nil {
+		return true
+	}
+	return cfg.IsAPIKeyModelAllowed(h.ClientAPIKeyFromContext(ctx), modelName)
+}
