+// SyncAPIKeyModelsWithAPIKeys keeps APIKeyModels aligned with APIKeys when keys
+// are replaced or removed through management endpoints, preventing deleted keys
+// from persisting in access.models and re-registering on reload.
+// An in-place key rotation only migrates model rules when previousKeys is
+// provided, has the exact same length, differs at strictly one index, removes
+// oldKey completely, and introduces a brand-new key not previously in APIKeys.
+func (c *SDKConfig) SyncAPIKeyModelsWithAPIKeys(previousKeys []string) {
+	if c == nil || len(c.APIKeyModels) == 0 {
+		return
+	}
+	currentSet := make(map[string]struct{}, len(c.APIKeys))
+	for _, raw := range c.APIKeys {
+		if k := strings.TrimSpace(raw); k != "" {
+			currentSet[k] = struct{}{}
+		}
+	}
+	if len(previousKeys) > 0 && len(previousKeys) == len(c.APIKeys) {
+		prevSet := make(map[string]struct{}, len(previousKeys))
+		changedIdx := -1
+		changedCount := 0
+		for i := range previousKeys {
+			oldKey := strings.TrimSpace(previousKeys[i])
+			if oldKey != "" {
+				prevSet[oldKey] = struct{}{}
+			}
+			newKey := strings.TrimSpace(c.APIKeys[i])
+			if oldKey != newKey {
+				changedIdx = i
+				changedCount++
+			}
+		}
+		if changedCount == 1 && changedIdx >= 0 {
+			oldKey := strings.TrimSpace(previousKeys[changedIdx])
+			newKey := strings.TrimSpace(c.APIKeys[changedIdx])
+			_, stillPresent := currentSet[oldKey]
+			_, existedBefore := prevSet[newKey]
+			if oldKey != "" && newKey != "" && !stillPresent && !existedBefore {
+				if models, hadOld := c.APIKeyModels[oldKey]; hadOld {
+					if _, hasNew := c.APIKeyModels[newKey]; !hasNew {
+						c.APIKeyModels[newKey] = append([]string(nil), models...)
+					}
+					delete(c.APIKeyModels, oldKey)
+				}
+			}
+		}
+	}
+	for key := range c.APIKeyModels {
+		if _, ok := currentSet[strings.TrimSpace(key)]; !ok {
+			delete(c.APIKeyModels, key)
+		}
+	}
+	if len(c.APIKeyModels) == 0 {
+		c.APIKeyModels = nil
+	}
