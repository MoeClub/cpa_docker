+	apiKey := h.ClientAPIKeyFromContext(ctx)
+	inheritedBase, inheritedEffort := inheritedModelAccessEffortFromContext(ctx)
+	return checkAPIKeyModelAccessWithBodyAndInherited(cfg, apiKey, modelName, rawJSON, catalogFallback, inheritedBase, inheritedEffort)
+}
+
+// ValidateAPIKeyModelAccessForGin returns a 403 ErrorMessage when c's client key is not permitted to use modelName.
+func (h *BaseAPIHandler) ValidateAPIKeyModelAccessForGin(c *gin.Context, modelName string) *interfaces.ErrorMessage {
+	if h.IsModelAllowedForGin(c, modelName) {
+		return nil
+	}
+	return newAPIKeyModelNotAllowedError(modelName)
+}
+
+// ValidateAPIKeyModelAccessWithBodyForGin validates modelName + body reasoning effort for Gin handlers.
+func (h *BaseAPIHandler) ValidateAPIKeyModelAccessWithBodyForGin(c *gin.Context, modelName string, rawJSON []byte) *interfaces.ErrorMessage {
+	return h.ValidateAPIKeyModelAccessWithInheritedEffortForGin(c, modelName, rawJSON, "", "")
+}
+
+// ValidateAPIKeyModelAccessWithInheritedEffortForGin validates modelName + body reasoning effort,
+// falling back to (inheritedBaseModel, inheritedEffort) when rawJSON and modelName omit explicit effort.
+func (h *BaseAPIHandler) ValidateAPIKeyModelAccessWithInheritedEffortForGin(c *gin.Context, modelName string, rawJSON []byte, inheritedBaseModel, inheritedEffort string) *interfaces.ErrorMessage {
+	if h == nil {
+		return nil
+	}
+	cfg := h.CurrentConfig()
+	if cfg == nil {
+		return nil
+	}
+	apiKey := h.ClientAPIKeyFromGin(c)
+	return checkAPIKeyModelAccessWithBodyAndInherited(cfg, apiKey, modelName, rawJSON, false, inheritedBaseModel, inheritedEffort)
+}
+
+// ValidateAPIKeyAliasedModelAccessForGin validates endpoints that accept standard
+// OpenAI model aliases (such as sora-2 -> grok-imagine-video or tts-1 -> grok-tts):
+// neither alias nor target may match an explicit "!" deny rule, and at least one
+// must be permitted by the key's allow rules.
+func (h *BaseAPIHandler) ValidateAPIKeyAliasedModelAccessForGin(c *gin.Context, requestedModel, routedModel string) *interfaces.ErrorMessage {
+	if h == nil {
+		return nil
+	}
+	cfg := h.CurrentConfig()
+	if cfg == nil {
+		return nil
+	}
+	apiKey := h.ClientAPIKeyFromGin(c)
+	if !cfg.IsAPIKeyRestricted(apiKey) {
+		return nil
+	}
+	requestedModel = strings.TrimSpace(requestedModel)
+	routedModel = strings.TrimSpace(routedModel)
+	displayModel := requestedModel
+	if displayModel == "" {
+		displayModel = routedModel
+	}
+	if requestedModel != "" && cfg.IsAPIKeyModelExplicitlyDenied(apiKey, requestedModel) {
+		return newAPIKeyModelNotAllowedError(requestedModel)
+	}
+	if routedModel != "" && cfg.IsAPIKeyModelExplicitlyDenied(apiKey, routedModel) {
+		return newAPIKeyModelNotAllowedError(displayModel)
+	}
+	if (requestedModel != "" && cfg.IsAPIKeyModelAllowed(apiKey, requestedModel)) ||
+		(routedModel != "" && cfg.IsAPIKeyModelAllowed(apiKey, routedModel)) {
+		return nil
+	}
+	return newAPIKeyModelNotAllowedError(displayModel)
+}
+
+func (h *BaseAPIHandler) validateResolvedModelAccess(ctx context.Context, originalRequestedModel, resolvedModel string, rawJSON []byte, catalogFallback bool) *interfaces.ErrorMessage {
+	if h == nil {
+		return nil
+	}
+	resolvedModel = strings.TrimSpace(resolvedModel)
+	if resolvedModel == "" {
+		return nil
+	}
+	cfg := h.CurrentConfig()
+	if cfg == nil {
+		return nil
+	}
+	apiKey := h.ClientAPIKeyFromContext(ctx)
+	if !cfg.IsAPIKeyRestricted(apiKey) {
+		return nil
+	}
+	inheritedBase, inheritedEffort := inheritedModelAccessEffortFromContext(ctx)
+	baseModel, candidates, requestedEfforts, hasInvalidSuffix := resolveRequestedModelsForAccess(resolvedModel, rawJSON)
+	if !hasInvalidSuffix && !thinking.HasThinkingSuffix(resolvedModel) && len(requestedEfforts) == 0 && inheritedEffort != "" && baseModel != "" {
+		requestedEfforts = []string{inheritedEffort}
+		candidates = []string{baseModel + "(" + inheritedEffort + ")"}
+	}
+	for _, candidate := range candidates {
+		if cfg.IsAPIKeyModelExplicitlyDenied(apiKey, candidate) {
+			return newAPIKeyModelNotAllowedError(candidate)
+		}
+	}
+	if !catalogFallback && baseModel != "" {
+		for _, eff := range thinking.EffectiveAccessDenyEfforts(baseModel, requestedEfforts) {
+			cand := baseModel + "(" + eff + ")"
+			if cfg.IsAPIKeyModelExplicitlyDenied(apiKey, cand) {
+				return newAPIKeyModelNotAllowedError(cand)
+			}
+		}
+	}
+	// If a ModelRouter stripped the thinking suffix from the same base model,
+	// body thinking fields are now active and must satisfy allow rules too.
+	if !isModelAccessPrevalidated(ctx) &&
+		thinking.HasThinkingSuffix(strings.TrimSpace(originalRequestedModel)) &&
+		!thinking.HasThinkingSuffix(resolvedModel) &&
+		sameAccessBaseModel(originalRequestedModel, resolvedModel) {
+		return checkAPIKeyModelAccessWithBodyAndInherited(cfg, apiKey, resolvedModel, rawJSON, catalogFallback, inheritedBase, inheritedEffort)
+	}
+	return nil
+}
+
+func sameAccessBaseModel(a, b string) bool {
+	norm := func(s string) string {
+		res := thinking.ParseSuffix(strings.TrimSpace(s))
+		base := strings.TrimSpace(res.ModelName)
+		if !res.HasSuffix || base == "" {
+			base = strings.TrimSpace(s)
+		}
+		base = strings.TrimPrefix(strings.ToLower(base), "models/")
+		if idx := strings.LastIndex(base, "/"); idx >= 0 && idx+1 < len(base) {
+			base = strings.TrimSpace(base[idx+1:])
+		}
+		return base
+	}
+	na, nb := norm(a), norm(b)
+	return na != "" && na == nb
+}
+
+func checkAPIKeyModelAccessWithBody(cfg *config.SDKConfig, apiKey, modelName string, rawJSON []byte, catalogFallback bool) *interfaces.ErrorMessage {
+	return checkAPIKeyModelAccessWithBodyAndInherited(cfg, apiKey, modelName, rawJSON, catalogFallback, "", "")
+}
+
+func checkAPIKeyModelAccessWithBodyAndInherited(cfg *config.SDKConfig, apiKey, modelName string, rawJSON []byte, catalogFallback bool, inheritedBaseModel, inheritedEffort string) *interfaces.ErrorMessage {
+	if cfg == nil || !cfg.IsAPIKeyRestricted(apiKey) {
+		return nil
+	}
+	baseModel, candidates, requestedEfforts, hasInvalidSuffix := resolveRequestedModelsForAccess(modelName, rawJSON)
+	inheritedEffort = normalizeAccessEffortToken(inheritedEffort)
+	if !hasInvalidSuffix && !thinking.HasThinkingSuffix(strings.TrimSpace(modelName)) && len(requestedEfforts) == 0 &&
+		inheritedEffort != "" && baseModel != "" && sameAccessBaseModel(baseModel, inheritedBaseModel) {
+		requestedEfforts = []string{inheritedEffort}
+		candidates = []string{baseModel + "(" + inheritedEffort + ")"}
+	}
+	if catalogFallback && len(requestedEfforts) == 0 && !hasInvalidSuffix && !thinking.HasThinkingSuffix(strings.TrimSpace(modelName)) {
+		if cfg.IsAPIKeyModelExplicitlyDenied(apiKey, baseModel) || !cfg.IsAPIKeyModelCatalogVisible(apiKey, baseModel) {
+			return newAPIKeyModelNotAllowedError(baseModel)
+		}
+		return nil
+	}
+	for _, candidate := range candidates {
+		if !cfg.IsAPIKeyModelAllowed(apiKey, candidate) {
+			return newAPIKeyModelNotAllowedError(candidate)
+		}
+	}
+	if baseModel != "" {
+		for _, eff := range thinking.EffectiveAccessDenyEfforts(baseModel, requestedEfforts) {
+			cand := baseModel + "(" + eff + ")"
+			if cfg.IsAPIKeyModelExplicitlyDenied(apiKey, cand) {
+				return newAPIKeyModelNotAllowedError(cand)
+			}
+		}
+	}
+	return nil
+}
+
+func normalizeAccessEffortToken(raw string) string {
+	effort := strings.ToLower(strings.TrimSpace(raw))
+	switch effort {
+	case "":
+		return ""
+	case "disabled", "persistent", "between_tools":
+		return "none"
+	default:
+		return effort
+	}
+}
+
+func normalizeSuffixEffortToken(rawSuffix string) string {
+	trimmed := strings.TrimSpace(rawSuffix)
+	if mode, ok := thinking.ParseSpecialSuffix(trimmed); ok {
+		switch mode {
+		case thinking.ModeNone:
+			return "none"
+		case thinking.ModeAuto:
+			return "auto"
+		}
+	}
+	if lvl, ok := thinking.ParseLevelSuffix(trimmed); ok {
+		return strings.ToLower(string(lvl))
+	}
+	if budget, ok := thinking.ParseNumericSuffix(trimmed); ok {
+		if budget == 0 {
+			return "none"
+		}
+		return strconv.Itoa(budget)
+	}
+	return ""
+}
+
+func appendUniqueEffort(efforts []string, effort string) []string {
+	effort = normalizeAccessEffortToken(effort)
+	if effort == "" {
+		return efforts
+	}
+	for _, existing := range efforts {
+		if existing == effort {
+			return efforts
+		}
+	}
+	return append(efforts, effort)
+}
+
+func appendUniqueString(list []string, item string) []string {
+	for _, existing := range list {
+		if strings.EqualFold(existing, item) {
+			return list
+		}
+	}
+	return append(list, item)
+}
+
+func collectConfigurationUpdateEfforts(input ojson.Result, efforts []string) []string {
+	if !input.IsArray() {
+		return efforts
+	}
+	input.ForEach(func(_, item ojson.Result) bool {
+		if item.Get("type").String() == "configuration_update" {
+			val := item.Get("reasoning.effort")
+			if val.Type == ojson.String {
+				efforts = appendUniqueEffort(efforts, val.String())
+			}
+		}
+		return true
+	})
+	return efforts
+}
+
+func collectTopLevelBodyEfforts(rawJSON []byte) []string {
+	if len(rawJSON) == 0 || !ojson.ValidBytes(rawJSON) {
+		return nil
+	}
+	var efforts []string
+	// Collect every explicit thinking/effort string field across protocols without
+	// early break so a benign decoy field from one protocol cannot mask an active
+	// effort field from another protocol.
+	for _, path := range []string{
+		"reasoning.effort",
+		"response.reasoning.effort",
+		"reasoning_effort",
+		"output_config.effort",
+		"thinking.effort",
+		"generationConfig.thinkingConfig.thinkingLevel",
+		"generationConfig.thinkingConfig.thinking_level",
+		"generation_config.thinking_config.thinking_level",
+		"generation_config.thinking_config.thinkingLevel",
+		"generation_config.thinkingConfig.thinking_level",
+		"generation_config.thinkingConfig.thinkingLevel",
+		"generation_config.thinking_level",
+		"generation_config.thinkingLevel",
+		"request.generationConfig.thinkingConfig.thinkingLevel",
+		"request.generationConfig.thinkingConfig.thinking_level",
+		"request.generation_config.thinking_level",
+		"request.generation_config.thinkingLevel",
+		"request.generation_config.thinking_config.thinking_level",
+		"request.generation_config.thinking_config.thinkingLevel",
+		"request.generation_config.thinkingConfig.thinking_level",
+		"request.generation_config.thinkingConfig.thinkingLevel",
+	} {
+		val := ojson.GetBytesNoCopy(rawJSON, path)
+		if val.Type == ojson.String {
+			efforts = appendUniqueEffort(efforts, val.String())
+		}
+	}
+
+	if directive := thinking.ClaudeEffortDirective(rawJSON); directive != "" {
+		efforts = appendUniqueEffort(efforts, directive)
+	}
+
+	hasBudgetOrEffort := len(efforts) > 0
+	for _, budgetPath := range []string{
+		"thinking.budget_tokens",
+		"generationConfig.thinkingConfig.thinkingBudget",
+		"generationConfig.thinkingConfig.thinking_budget",
+		"generation_config.thinking_config.thinking_budget",
+		"generation_config.thinking_config.thinkingBudget",
+		"generation_config.thinking_budget",
+		"generation_config.thinkingBudget",
+		"request.generationConfig.thinkingConfig.thinkingBudget",
+		"request.generationConfig.thinkingConfig.thinking_budget",
+		"request.generation_config.thinking_budget",
+		"request.generation_config.thinkingBudget",
+		"request.generation_config.thinking_config.thinking_budget",
+		"request.generation_config.thinking_config.thinkingBudget",
+		"request.generation_config.thinkingConfig.thinking_budget",
+		"request.generation_config.thinkingConfig.thinkingBudget",
+	} {
+		bVal := ojson.GetBytesNoCopy(rawJSON, budgetPath)
+		if bVal.Type == ojson.Number {
+			hasBudgetOrEffort = true
+			n := bVal.Int()
+			switch {
+			case n == 0:
+				efforts = appendUniqueEffort(efforts, "none")
+			case n == -1:
+				efforts = appendUniqueEffort(efforts, "auto")
+			case n > 0:
+				efforts = appendUniqueEffort(efforts, strconv.FormatInt(n, 10))
+			}
+		}
+	}
+
+	switch strings.ToLower(strings.TrimSpace(ojson.GetBytesNoCopy(rawJSON, "thinking.type").String())) {
+	case "disabled", "between_tools":
+		efforts = appendUniqueEffort(efforts, "none")
+	case "enabled", "auto":
+		if !hasBudgetOrEffort {
+			efforts = appendUniqueEffort(efforts, "auto")
+		}
+	}
+
+	return efforts
+}
+
+func resolveRequestedModelsForAccess(modelName string, rawJSON []byte) (baseModel string, candidates []string, requestedEfforts []string, hasInvalidSuffix bool) {
+	trimmedModel := strings.TrimSpace(modelName)
+	if trimmedModel == "" {
+		return "", []string{""}, nil, false
+	}
+	suffixRes := thinking.ParseSuffix(trimmedModel)
+	baseModel = trimmedModel
+	if suffixRes.HasSuffix && strings.TrimSpace(suffixRes.ModelName) != "" {
+		baseModel = strings.TrimSpace(suffixRes.ModelName)
+	}
+
+	var updateEfforts []string
+	if len(rawJSON) > 0 && ojson.ValidBytes(rawJSON) {
+		updateEfforts = collectConfigurationUpdateEfforts(ojson.GetBytesNoCopy(rawJSON, "input"), updateEfforts)
+		updateEfforts = collectConfigurationUpdateEfforts(ojson.GetBytesNoCopy(rawJSON, "response.input"), updateEfforts)
+	}
+
+	if suffixRes.HasSuffix && thinking.HasThinkingSuffix(trimmedModel) {
+		normSuffix := normalizeSuffixEffortToken(suffixRes.RawSuffix)
+		if normSuffix != "" {
+			candidates = appendUniqueString(candidates, baseModel+"("+normSuffix+")")
+			requestedEfforts = appendUniqueEffort(requestedEfforts, normSuffix)
+		} else {
+			candidates = appendUniqueString(candidates, trimmedModel)
+		}
+		for _, ue := range updateEfforts {
+			candidates = appendUniqueString(candidates, baseModel+"("+ue+")")
+			requestedEfforts = appendUniqueEffort(requestedEfforts, ue)
+		}
+		return baseModel, candidates, requestedEfforts, false
+	}
+
+	// Empty ("gpt-5.4()") or unrecognized ("gpt-5.4(bogus)") suffixes do not
+	// override body thinking fields in ApplyThinking, so body efforts must still
+	// be inspected against baseModel.
+	topEfforts := collectTopLevelBodyEfforts(rawJSON)
+	for _, te := range topEfforts {
+		requestedEfforts = appendUniqueEffort(requestedEfforts, te)
+	}
+	for _, ue := range updateEfforts {
+		requestedEfforts = appendUniqueEffort(requestedEfforts, ue)
+	}
+
+	if suffixRes.HasSuffix {
+		hasInvalidSuffix = strings.TrimSpace(suffixRes.RawSuffix) != ""
+		if hasInvalidSuffix {
+			candidates = appendUniqueString(candidates, trimmedModel)
+		}
+	}
+	if len(requestedEfforts) == 0 {
+		if len(candidates) == 0 {
+			candidates = []string{baseModel}
+		}
+		return baseModel, candidates, nil, hasInvalidSuffix
+	}
+	for _, effort := range requestedEfforts {
+		candidates = appendUniqueString(candidates, baseModel+"("+effort+")")
+	}
+	return baseModel, candidates, requestedEfforts, hasInvalidSuffix
+}
+
+func effectiveRequestedModelsForAccess(modelName string, rawJSON []byte) []string {
+	_, candidates, _, _ := resolveRequestedModelsForAccess(modelName, rawJSON)
+	return candidates
+}
+
+func modelMapIdentifier(model map[string]any) string {
+	if model == nil {
+		return ""
+	}
+	for _, key := range []string{"id", "slug", "name"} {
+		if val, ok := model[key].(string); ok {
+			if trimmed := strings.TrimSpace(val); trimmed != "" {
+				return trimmed
+			}
+		}
+	}
+	return ""
+}
+
+func newAPIKeyModelNotAllowedError(modelName string) *interfaces.ErrorMessage {
+	payload, errMarshal := json.Marshal(map[string]any{
+		"error": map[string]any{
+			"message": "model " + modelName + " is not allowed for this API key",
+			"type":    "permission_error",
+			"code":    "model_not_allowed",
+			"param":   "model",
+		},
+	})
+	if errMarshal != nil {
+		payload = []byte(`{"error":{"message":"model is not allowed for this API key","type":"permission_error","code":"model_not_allowed","param":"model"}}`)
+	}
+	return &interfaces.ErrorMessage{
+		StatusCode: http.StatusForbidden,
+		Error:      fmt.Errorf("%s", payload),
+	}
+}
