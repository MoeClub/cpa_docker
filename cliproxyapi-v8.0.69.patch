+		t.Fatalf("revoked key resurrected in APIKeys: %v", reloaded.APIKeys)
+	}
+	if !reloaded.IsAPIKeyModelAllowed("sk-rotated", "kimi-k2.5") || reloaded.IsAPIKeyModelAllowed("sk-rotated", "glm-5.3") {
+		t.Fatal("expected rotated key to inherit kimi-* restriction")
+	}
+}
