+func TestCallbackForwarderRefCountingPreservesConcurrentOAuthSessions(t *testing.T) {
+	probeLn, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatalf("probe listen: %v", err)
+	}
+	port := probeLn.Addr().(*net.TCPAddr).Port
+	_ = probeLn.Close()
+
+	const target = "http://127.0.0.1:8317/antigravity/callback"
+	f1, err := startCallbackForwarder(port, "antigravity", target)
+	if err != nil {
+		t.Fatalf("startCallbackForwarder #1: %v", err)
+	}
+	defer stopCallbackForwarderInstance(port, f1)
+
+	f2, err := startCallbackForwarder(port, "antigravity", target)
+	if err != nil {
+		t.Fatalf("startCallbackForwarder #2: %v", err)
+	}
+	if f1 != f2 {
+		defer stopCallbackForwarderInstance(port, f2)
+		t.Fatal("expected concurrent WebUI OAuth session on same port/provider/target to share ref-counted forwarder")
+	}
+
+	// Completing session #2 must NOT tear down session #1's listener.
+	stopCallbackForwarderInstance(port, f2)
+
+	client := &http.Client{
+		CheckRedirect: func(*http.Request, []*http.Request) error {
+			return http.ErrUseLastResponse
+		},
+	}
+	resp, err := client.Get("http://127.0.0.1:" + strconv.Itoa(port) + "/oauth-callback?code=abc&state=s1")
+	if err != nil {
+		t.Fatalf("forwarder stopped prematurely while session #1 was still active: %v", err)
+	}
+	_ = resp.Body.Close()
+	if resp.StatusCode != http.StatusFound {
+		t.Fatalf("forwarder status = %d, want 302", resp.StatusCode)
+	}
+	if loc := resp.Header.Get("Location"); loc != target+"?code=abc&state=s1" {
+		t.Fatalf("Location = %q, want %q", loc, target+"?code=abc&state=s1")
+	}
+
+	// Completing session #1 shuts down the forwarder.
+	stopCallbackForwarderInstance(port, f1)
+	if _, err := client.Get("http://127.0.0.1:" + strconv.Itoa(port) + "/oauth-callback?code=abc&state=s1"); err == nil {
+		t.Fatal("expected forwarder to shut down once final reference released")
+	}
+}
