--- /dev/null
+++ b/internal/registry/antigravity_enum_test.go
@@ -0,0 +1,75 @@
+package registry
+
+import (
+	"slices"
+	"testing"
+)
+
+func TestModelRegistryPreservesAntigravityModelEnumAcrossMultiClientLifecycle(t *testing.T) {
+	reg := newTestModelRegistry()
+	const (
+		clientA = "ag-client-a"
+		clientB = "ag-client-b"
+		modelID = "gemini-dynamic-probed"
+	)
+
+	reg.RegisterClient(clientA, "antigravity", []*ModelInfo{
+		{ID: modelID, AntigravityModelEnum: "MODEL_PLACEHOLDER_M99"},
+	})
+	// Second client registering without the enum (e.g. before its async probe finishes)
+	// must NOT clobber clientA's discovered enum.
+	reg.RegisterClient(clientB, "antigravity", []*ModelInfo{
+		{ID: modelID},
+	})
+
+	if info := reg.GetModelInfo(modelID, "antigravity"); info == nil || info.AntigravityModelEnum != "MODEL_PLACEHOLDER_M99" {
+		t.Fatalf("GetModelInfo(antigravity) enum = %+v, want MODEL_PLACEHOLDER_M99", info)
+	}
+	if info := reg.GetModelInfo(modelID, ""); info == nil || info.AntigravityModelEnum != "MODEL_PLACEHOLDER_M99" {
+		t.Fatalf("GetModelInfo(aggregate) enum = %+v, want MODEL_PLACEHOLDER_M99", info)
+	}
+
+	// Unregistering clientB keeps clientA's enum intact.
+	reg.UnregisterClient(clientB)
+	if info := reg.GetModelInfo(modelID, "antigravity"); info == nil || info.AntigravityModelEnum != "MODEL_PLACEHOLDER_M99" {
+		t.Fatalf("after UnregisterClient(clientB), enum = %+v, want MODEL_PLACEHOLDER_M99", info)
+	}
+
+	// Re-register clientB without enum, then unregister clientA -> enum clears cleanly until clientB probes.
+	reg.RegisterClient(clientB, "antigravity", []*ModelInfo{{ID: modelID}})
+	epochB := reg.ClientRegistrationEpoch(clientB)
+	reg.UnregisterClient(clientA)
+	if info := reg.GetModelInfo(modelID, "antigravity"); info == nil || info.AntigravityModelEnum != "" {
+		t.Fatalf("after UnregisterClient(clientA), enum = %+v, want empty", info)
+	}
+
+	// Async capability probe via ApplyClientModelCapabilities propagates enum to aggregate & provider Info.
+	if ok := reg.ApplyClientModelCapabilities(clientB, epochB, func(id string, info *ModelInfo) {
+		if id == modelID {
+			info.AntigravityModelEnum = "MODEL_PLACEHOLDER_M777"
+		}
+	}); !ok {
+		t.Fatal("ApplyClientModelCapabilities returned false")
+	}
+	if info := reg.GetModelInfo(modelID, "antigravity"); info == nil || info.AntigravityModelEnum != "MODEL_PLACEHOLDER_M777" {
+		t.Fatalf("after ApplyClientModelCapabilities, enum = %+v, want MODEL_PLACEHOLDER_M777", info)
+	}
+}
+
+func TestCloneModelInfoDeepCopiesCodexLevelMap(t *testing.T) {
+	orig := &ModelInfo{
+		ID: "gemini-4-argon",
+		Thinking: &ThinkingSupport{
+			Levels:       []string{"low", "high"},
+			DefaultLevel: "high",
+			CodexLevelMap: []CodexLevelMapping{
+				{Codex: "xhigh", Level: "high"},
+			},
+		},
+	}
+	cloned := cloneModelInfo(orig)
+	cloned.Thinking.CodexLevelMap[0].Level = "low"
+	if !slices.Equal(orig.Thinking.CodexLevelMap, []CodexLevelMapping{{Codex: "xhigh", Level: "high"}}) {
+		t.Fatalf("mutating cloned CodexLevelMap mutated original: %+v", orig.Thinking.CodexLevelMap)
+	}
+}
