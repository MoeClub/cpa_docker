+// WithInheritedModelAccessEffort attaches the active session model and reasoning effort
+// (e.g., from an earlier authorized response.create on the same WebSocket connection) so
+// incremental continuation turns that omit explicit effort inherit it for access checks.
+func WithInheritedModelAccessEffort(ctx context.Context, baseModel, effort string) context.Context {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	baseModel = strings.TrimSpace(baseModel)
+	effort = normalizeAccessEffortToken(effort)
+	if baseModel == "" || effort == "" {
+		return ctx
+	}
+	return context.WithValue(ctx, inheritedModelAccessEffortContextKey{}, inheritedModelAccessEffort{
+		baseModel: baseModel,
+		effort:    effort,
+	})
+}
