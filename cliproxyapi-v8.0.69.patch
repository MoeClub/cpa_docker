+func catalogDefaultFromThinking(thinking *registry.ThinkingSupport) string {
+	if thinking == nil {
+		return ""
+	}
+	defaultLevel := strings.ToLower(strings.TrimSpace(thinking.DefaultLevel))
+	if defaultLevel == "" {
+		return ""
+	}
+	if len(thinking.CodexLevelMap) == 0 {
+		return defaultLevel
+	}
+	for index := len(thinking.CodexLevelMap) - 1; index >= 0; index-- {
+		mapping := thinking.CodexLevelMap[index]
+		if strings.EqualFold(strings.TrimSpace(mapping.Level), defaultLevel) {
+			return mapping.Codex
+		}
+	}
+	for _, level := range thinking.Levels {
+		if strings.EqualFold(strings.TrimSpace(level), defaultLevel) {
+			return defaultLevel
+		}
+	}
+	return defaultLevel
+}
