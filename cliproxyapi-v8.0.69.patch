+      - "claude-sonnet-4-5"
+    "sk-unrestricted-empty": []
+`)
+	if err := ValidateV8Config(raw); err != nil {
+		t.Fatalf("ValidateV8Config() error = %v", err)
+	}
+	cfg, err := ParseConfigBytes(raw)
+	if err != nil {
+		t.Fatalf("ParseConfigBytes() error = %v", err)
+	}
+
+	wantKeys := []string{"sk-unrestricted", "sk-inline-Empty", "sk-inline", "sk-structured", "sk-section", "sk-unrestricted-empty"}
+	if !slices.Equal(cfg.APIKeys, wantKeys) {
+		t.Fatalf("APIKeys = %v, want %v", cfg.APIKeys, wantKeys)
+	}
+
+	if !cfg.IsAPIKeyModelAllowed("sk-unrestricted", "any-model") {
+		t.Fatal("expected sk-unrestricted to allow any model")
+	}
+	if !cfg.IsAPIKeyModelAllowed("sk-inline-Empty", "any-model") {
+		t.Fatal("expected sk-inline-Empty with empty model list to allow any model")
+	}
+	if !cfg.IsAPIKeyModelAllowed("sk-unrestricted-empty", "any-model") {
+		t.Fatal("expected sk-unrestricted-empty with empty model list to allow any model")
+	}
+	if !cfg.IsAPIKeyModelAllowed("sk-unknown", "any-model") {
+		t.Fatal("expected key absent from APIKeyModels to allow any model")
+	}
+
+	if !cfg.IsAPIKeyModelAllowed("sk-inline", "deepseek-v4.1-flash") {
+		t.Fatal("expected sk-inline to allow deepseek-v4.1-flash")
+	}
+	if !cfg.IsAPIKeyModelAllowed("sk-inline", "deepseek-v4.1-flash(high)") {
+		t.Fatal("expected sk-inline to allow deepseek-v4.1-flash(high)")
+	}
+	if !cfg.IsAPIKeyModelAllowed("sk-inline", "glm-5.3") {
+		t.Fatal("expected sk-inline to allow glm-5.3")
+	}
+	if cfg.IsAPIKeyModelAllowed("sk-inline", "kimi-k2.5") {
+		t.Fatal("expected sk-inline to reject kimi-k2.5")
