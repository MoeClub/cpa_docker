+// FilterModelsForGin filters a model catalog slice according to the client API key's allowed models.
+func (h *BaseAPIHandler) FilterModelsForGin(c *gin.Context, models []map[string]any) []map[string]any {
+	if h == nil || len(models) == 0 {
+		return models
+	}
+	cfg := h.CurrentConfig()
+	apiKey := h.ClientAPIKeyFromGin(c)
+	if cfg == nil || !cfg.IsAPIKeyRestricted(apiKey) {
+		return models
+	}
+	filtered := make([]map[string]any, 0, len(models))
+	for _, model := range models {
+		id := modelMapIdentifier(model)
+		if id != "" && !cfg.IsAPIKeyModelCatalogVisible(apiKey, id) {
+			continue
+		}
+		filtered = append(filtered, model)
+	}
+	return filtered
+}
