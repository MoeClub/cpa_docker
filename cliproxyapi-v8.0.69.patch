+			}
+		}
+		modelsNode.Content = kept
+		if len(modelsNode.Content) == 0 && inlineModelsNode == nil {
+			deleteYAMLPath(root, "access.models")
+		}
+	}
+
+	if canonKeysNode != nil {
+		setYAMLPath(root, "access.api-keys", canonKeysNode)
+	}
+	if inlineModelsNode != nil {
+		if _, err := normalizeAccessKeysAndModels(root, "access.api-keys", "access.models", true); err != nil {
