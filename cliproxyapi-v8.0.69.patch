+func reasoningEffortFromJSON(t *testing.T, data []byte) string {
+	t.Helper()
+	var parsed struct {
+		ReasoningEffort string `json:"reasoning_effort"`
+	}
+	if err := json.Unmarshal(data, &parsed); err != nil {
+		t.Fatalf("unmarshal output JSON: %v; body=%s", err, data)
+	}
+	return parsed.ReasoningEffort
+}
+
+func TestApplyThinkingNormalizesCodexClientEffortAliases(t *testing.T) {
+	modelInfo := &registry.ModelInfo{
+		ID:   "compat-model",
+		Type: "openai-compatibility",
+		Thinking: &registry.ThinkingSupport{
+			Levels:       []string{"low", "high", "max"},
+			DefaultLevel: "max",
+			CodexLevelMap: []registry.CodexLevelMapping{
+				{Codex: "xhigh", Level: "max"},
+				{Codex: "ultra", Level: "max"},
+			},
+		},
+	}
+
+	tests := []struct {
+		name   string
+		effort string
+		want   string
+	}{
+		{name: "low", effort: "low", want: "low"},
+		{name: "medium maps to advanced", effort: "medium", want: "high"},
+		{name: "high", effort: "high", want: "high"},
+		{name: "xhigh maps to maximum", effort: "xhigh", want: "max"},
+		{name: "ultra maps to maximum", effort: "ultra", want: "max"},
+		{name: "max stays maximum", effort: "max", want: "max"},
+		{name: "persistent maps to disabled then lowest level", effort: "persistent", want: "low"},
+		{name: "disabled maps to lowest level", effort: "disabled", want: "low"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			body := []byte(`{"model":"compat-model","messages":[{"role":"user","content":"hi"}],"reasoning_effort":"medium"}`)
+			source := []byte(`{"model":"compat-model","reasoning":{"effort":"` + tt.effort + `"},"input":"hi"}`)
+			out, err := thinking.ApplyThinkingWithModelInfo(
+				body, source, "compat-model", "openai-response", "openai", "openai-compatibility", modelInfo,
+			)
+			if err != nil {
+				t.Fatalf("ApplyThinkingWithModelInfo() error = %v; body=%s", err, out)
+			}
+			if got := reasoningEffortFromJSON(t, out); got != tt.want {
+				t.Fatalf("reasoning_effort = %q, want %q; body=%s", got, tt.want, out)
+			}
+		})
+	}
+}
