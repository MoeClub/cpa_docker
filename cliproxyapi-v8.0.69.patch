diff --git a/internal/api/api_key_models_filter_test.go b/internal/api/api_key_models_filter_test.go
new file mode 100644
index 0000000..19793f6
--- /dev/null
+++ b/internal/api/api_key_models_filter_test.go
@@ -0,0 +1,317 @@
+package api
+
+import (
+	"bytes"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"path/filepath"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/access"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/registry"
+	sdkaccess "github.com/router-for-me/CLIProxyAPI/v8/sdk/access"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+)
+
+func TestServer_APIKeyModelFiltering(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+
+	rawCfg := []byte(`config-version: 8
+access:
+  api-keys:
+    - "sk-unrestricted"
+    - "sk-only-deepseek":
+        - "test-filter-deepseek"
+    - "sk-low-only":
+        - "test-filter-codex(low)"
+    - "sk-no-xhigh":
+        - "*"
+        - "!test-filter-codex(xhigh)"
+    - "sk-no-media":
+        - "*"
+        - "!sora-*"
+        - "!tts-*"
+        - "!gpt-image-*"
+    - "sk-deny-all":
+        - "!*"
+`)
+	cfg, err := config.ParseConfigBytes(rawCfg)
+	if err != nil {
+		t.Fatalf("ParseConfigBytes() error = %v", err)
+	}
+
+	accessMgr := sdkaccess.NewManager()
+	if _, err := access.ApplyAccessProviders(accessMgr, nil, cfg); err != nil {
+		t.Fatalf("ApplyAccessProviders() error = %v", err)
+	}
+
+	reg := registry.GetGlobalRegistry()
+	clientID := "test-apikey-model-filter-client"
+	reg.RegisterClient(clientID, "openai", []*registry.ModelInfo{
+		{ID: "test-filter-deepseek", OwnedBy: "test"},
+		{ID: "test-filter-glm", OwnedBy: "test"},
+		{
+			ID:      "test-filter-codex",
+			OwnedBy: "openai",
+			Type:    "codex",
+			Thinking: &registry.ThinkingSupport{
+				Levels:       []string{"low", "medium", "high", "xhigh"},
+				DefaultLevel: "high",
+			},
+		},
+	})
+	t.Cleanup(func() {
+		reg.UnregisterClient(clientID)
+	})
+
+	authMgr := coreauth.NewManager(nil, nil, nil)
+	srv := NewServer(cfg, authMgr, accessMgr, filepath.Join(t.TempDir(), "config.yaml"))
+
+	fetchModelIDs := func(t *testing.T, path, apiKey string, extraHeaders map[string]string) (int, []string) {
+		t.Helper()
+		req := httptest.NewRequest(http.MethodGet, path, nil)
+		req.Header.Set("Authorization", "Bearer "+apiKey)
+		for k, v := range extraHeaders {
+			req.Header.Set(k, v)
+		}
+		rec := httptest.NewRecorder()
+		srv.engine.ServeHTTP(rec, req)
+		if rec.Code != http.StatusOK {
+			return rec.Code, nil
+		}
+		var payload struct {
+			Data []struct {
+				ID string `json:"id"`
+			} `json:"data"`
+			Models []struct {
+				Slug string `json:"slug"`
+				Name string `json:"name"`
+			} `json:"models"`
+		}
+		if err := json.Unmarshal(rec.Body.Bytes(), &payload); err != nil {
+			t.Fatalf("unmarshal models response: %v (body=%s)", err, rec.Body.String())
+		}
+		var ids []string
+		for _, item := range payload.Data {
+			ids = append(ids, item.ID)
+		}
+		for _, item := range payload.Models {
+			if item.Slug != "" {
+				ids = append(ids, item.Slug)
+			} else if item.Name != "" {
+				ids = append(ids, item.Name)
+			}
+		}
+		return rec.Code, ids
+	}
+
+	containsModel := func(ids []string, target string) bool {
+		for _, id := range ids {
+			if id == target {
+				return true
+			}
+		}
+		return false
+	}
+
+	// 1. Restricted key only sees test-filter-deepseek on /v1/models and Codex /v1/models?client_version=...
+	code, restrictedIDs := fetchModelIDs(t, "/v1/models", "sk-only-deepseek", nil)
+	if code != http.StatusOK {
+		t.Fatalf("GET /v1/models status = %d, want 200", code)
+	}
+	if !containsModel(restrictedIDs, "test-filter-deepseek") || containsModel(restrictedIDs, "test-filter-glm") {
+		t.Fatalf("restricted /v1/models IDs = %v, want test-filter-deepseek without test-filter-glm", restrictedIDs)
+	}
+
+	code, codexIDs := fetchModelIDs(t, "/v1/models?client_version=0.163.0", "sk-only-deepseek", nil)
+	if code != http.StatusOK {
+		t.Fatalf("GET /v1/models?client_version status = %d, want 200", code)
+	}
+	if !containsModel(codexIDs, "test-filter-deepseek") || containsModel(codexIDs, "test-filter-glm") {
+		t.Fatalf("restricted Codex /v1/models IDs = %v, want test-filter-deepseek without test-filter-glm", codexIDs)
+	}
+
+	// 2. Unrestricted key sees both models
+	code, unrestrictedIDs := fetchModelIDs(t, "/v1/models", "sk-unrestricted", nil)
+	if code != http.StatusOK {
+		t.Fatalf("GET /v1/models status = %d, want 200", code)
+	}
+	if !containsModel(unrestrictedIDs, "test-filter-deepseek") || !containsModel(unrestrictedIDs, "test-filter-glm") {
+		t.Fatalf("unrestricted /v1/models IDs = %v, want both test models", unrestrictedIDs)
+	}
+
+	// 3. Single model detail endpoint /v1/models/:model respects per-key restriction
+	reqAllowedDetail := httptest.NewRequest(http.MethodGet, "/v1/models/test-filter-deepseek", nil)
+	reqAllowedDetail.Header.Set("Authorization", "Bearer sk-only-deepseek")
+	recAllowedDetail := httptest.NewRecorder()
+	srv.engine.ServeHTTP(recAllowedDetail, reqAllowedDetail)
+	if recAllowedDetail.Code != http.StatusOK {
+		t.Fatalf("GET /v1/models/test-filter-deepseek status = %d, want 200", recAllowedDetail.Code)
+	}
+
+	reqBlockedDetail := httptest.NewRequest(http.MethodGet, "/v1/models/test-filter-glm", nil)
+	reqBlockedDetail.Header.Set("Authorization", "Bearer sk-only-deepseek")
+	recBlockedDetail := httptest.NewRecorder()
+	srv.engine.ServeHTTP(recBlockedDetail, reqBlockedDetail)
+	if recBlockedDetail.Code != http.StatusNotFound {
+		t.Fatalf("GET /v1/models/test-filter-glm status = %d, want 404", recBlockedDetail.Code)
+	}
+
+	// 4. Execution endpoints reject disallowed model with 403 model_not_allowed
+	for _, endpoint := range []string{"/v1/chat/completions", "/v1/responses"} {
+		body := []byte(`{"model":"test-filter-glm","messages":[{"role":"user","content":"hi"}],"input":"hi"}`)
+		req := httptest.NewRequest(http.MethodPost, endpoint, bytes.NewReader(body))
+		req.Header.Set("Content-Type", "application/json")
+		req.Header.Set("Authorization", "Bearer sk-only-deepseek")
+		rec := httptest.NewRecorder()
+		srv.engine.ServeHTTP(rec, req)
+		if rec.Code != http.StatusForbidden {
+			t.Fatalf("POST %s with disallowed model status = %d, want 403 (body=%s)", endpoint, rec.Code, rec.Body.String())
+		}
+	}
+
+	// 5. Suffix-pinned key sees base model in /v1/models and gets pruned reasoning levels on Codex /v1/models
+	code, lowCatalogIDs := fetchModelIDs(t, "/v1/models", "sk-low-only", nil)
+	if code != http.StatusOK || !containsModel(lowCatalogIDs, "test-filter-codex") {
+		t.Fatalf("suffix-pinned /v1/models status=%d IDs=%v, want test-filter-codex visible", code, lowCatalogIDs)
+	}
+	reqCodexLow := httptest.NewRequest(http.MethodGet, "/v1/models?client_version=0.163.0", nil)
+	reqCodexLow.Header.Set("Authorization", "Bearer sk-low-only")
+	recCodexLow := httptest.NewRecorder()
+	srv.engine.ServeHTTP(recCodexLow, reqCodexLow)
+	if recCodexLow.Code != http.StatusOK {
+		t.Fatalf("GET /v1/models?client_version for sk-low-only status = %d, want 200", recCodexLow.Code)
+	}
+	var codexLowPayload struct {
+		Models []struct {
+			Slug                   string `json:"slug"`
+			DefaultReasoningLevel  string `json:"default_reasoning_level"`
+			SupportedReasoningList []struct {
+				Effort string `json:"effort"`
+			} `json:"supported_reasoning_levels"`
+		} `json:"models"`
+	}
+	if err := json.Unmarshal(recCodexLow.Body.Bytes(), &codexLowPayload); err != nil {
+		t.Fatalf("unmarshal codex low models: %v", err)
+	}
+	if len(codexLowPayload.Models) != 1 || codexLowPayload.Models[0].Slug != "test-filter-codex" {
+		t.Fatalf("codex low models = %+v, want [test-filter-codex]", codexLowPayload.Models)
+	}
+	if codexLowPayload.Models[0].DefaultReasoningLevel != "low" || len(codexLowPayload.Models[0].SupportedReasoningList) != 1 || codexLowPayload.Models[0].SupportedReasoningList[0].Effort != "low" {
+		t.Fatalf("codex low reasoning levels = %+v, want default=low and supported=[low]", codexLowPayload.Models[0])
+	}
+
+	// 6. Body reasoning effort enforcement: sk-low-only blocks high or unsuffixed, allows low past 403 gate;
+	// sk-no-xhigh blocks xhigh both at top-level and inside configuration_update items!
+	assertStatus := func(method, path, apiKey, body string, wantCode int) {
+		t.Helper()
+		var reqBody *bytes.Reader
+		if body != "" {
+			reqBody = bytes.NewReader([]byte(body))
+		} else {
+			reqBody = bytes.NewReader(nil)
+		}
+		req := httptest.NewRequest(method, path, reqBody)
+		if body != "" {
+			req.Header.Set("Content-Type", "application/json")
+		}
+		req.Header.Set("Authorization", "Bearer "+apiKey)
+		rec := httptest.NewRecorder()
+		srv.engine.ServeHTTP(rec, req)
+		if rec.Code != wantCode {
+			t.Fatalf("%s %s (key=%s) status = %d, want %d (body=%s)", method, path, apiKey, rec.Code, wantCode, rec.Body.String())
+		}
+	}
+
+	assertStatus(http.MethodPost, "/v1/responses", "sk-low-only", `{"model":"test-filter-codex","reasoning":{"effort":"high"},"input":"hi"}`, http.StatusForbidden)
+	assertStatus(http.MethodPost, "/v1/responses", "sk-low-only", `{"model":"test-filter-codex","input":"hi"}`, http.StatusForbidden)
+	reqLowAllowed := httptest.NewRequest(http.MethodPost, "/v1/responses", bytes.NewReader([]byte(`{"model":"test-filter-codex","reasoning":{"effort":"low"},"input":"hi"}`)))
+	reqLowAllowed.Header.Set("Content-Type", "application/json")
+	reqLowAllowed.Header.Set("Authorization", "Bearer sk-low-only")
+	recLowAllowed := httptest.NewRecorder()
+	srv.engine.ServeHTTP(recLowAllowed, reqLowAllowed)
+	if recLowAllowed.Code == http.StatusForbidden {
+		t.Fatalf("POST /v1/responses with allowed low effort unexpectedly returned 403: %s", recLowAllowed.Body.String())
+	}
+
+	assertStatus(http.MethodPost, "/v1/responses", "sk-no-xhigh", `{"model":"test-filter-codex","reasoning":{"effort":"xhigh"},"input":"hi"}`, http.StatusForbidden)
+	assertStatus(http.MethodPost, "/v1/responses", "sk-no-xhigh", `{"model":"test-filter-codex","reasoning":{"effort":"low"},"input":[{"type":"configuration_update","reasoning":{"effort":"xhigh"}},{"type":"message","role":"user","content":"hi"}]}`, http.StatusForbidden)
+
+	// 7. Model-less /v1/alpha/search, Realtime endpoints, and Media endpoints enforce APIKeyModels!
+	assertStatus(http.MethodPost, "/v1/alpha/search", "sk-only-deepseek", `{"query":"hello"}`, http.StatusForbidden)
+	assertStatus(http.MethodPost, "/v1/alpha/search", "sk-deny-all", `{"query":"hello"}`, http.StatusForbidden)
+
+	assertStatus(http.MethodPost, "/v1/realtime/client_secrets", "sk-only-deepseek", `{"session":{"type":"realtime","model":"gpt-realtime"}}`, http.StatusForbidden)
+	assertStatus(http.MethodPost, "/v1/realtime/sessions", "sk-only-deepseek", `{"model":"gpt-realtime"}`, http.StatusForbidden)
+	assertStatus(http.MethodGet, "/v1/realtime?model=gpt-realtime", "sk-only-deepseek", "", http.StatusForbidden)
+	assertStatus(http.MethodPost, "/v1/realtime/calls?model=gpt-realtime", "sk-only-deepseek", `{"sdp":"v=0\r\n","session":{"type":"realtime","model":"gpt-realtime"}}`, http.StatusForbidden)
+
+	assertStatus(http.MethodPost, "/openai/v1/videos", "sk-no-media", `{"model":"sora-2","prompt":"ocean"}`, http.StatusForbidden)
+	assertStatus(http.MethodPost, "/v1/audio/speech", "sk-no-media", `{"model":"tts-1","input":"hello","voice":"alloy"}`, http.StatusForbidden)
+	assertStatus(http.MethodPost, "/v1/images/generations", "sk-no-media", `{"model":"gpt-image-2","prompt":"sunset"}`, http.StatusForbidden)
+	assertStatus(http.MethodPost, "/v1/images/generations", "sk-only-deepseek", `{"model":"gpt-image-2","prompt":"sunset"}`, http.StatusForbidden)
+
+	// 8. Second-pass security regressions:
+	// - Cross-protocol decoy thinking field ("reasoning_effort":"low" masking "reasoning":{"effort":"high"}) -> 403
+	assertStatus(http.MethodPost, "/v1/responses", "sk-low-only", `{"model":"test-filter-codex","reasoning_effort":"low","reasoning":{"effort":"high"},"input":"hi"}`, http.StatusForbidden)
+	// - Empty or invalid model suffixes ("test-filter-codex()", "test-filter-codex(bogus)") -> 403
+	assertStatus(http.MethodPost, "/v1/responses", "sk-low-only", `{"model":"test-filter-codex()","input":"hi"}`, http.StatusForbidden)
+	assertStatus(http.MethodPost, "/v1/responses", "sk-low-only", `{"model":"test-filter-codex(bogus)","reasoning":{"effort":"low"},"input":"hi"}`, http.StatusForbidden)
+	assertStatus(http.MethodPost, "/v1/responses", "sk-no-xhigh", `{"model":"test-filter-codex()","reasoning":{"effort":"xhigh"},"input":"hi"}`, http.StatusForbidden)
+	// - !xhigh blocks ultra alias (clamps to xhigh) and high token budget (32768 -> xhigh) -> 403
+	assertStatus(http.MethodPost, "/v1/responses", "sk-no-xhigh", `{"model":"test-filter-codex","reasoning":{"effort":"ultra"},"input":"hi"}`, http.StatusForbidden)
+	assertStatus(http.MethodPost, "/v1/responses", "sk-no-xhigh", `{"model":"test-filter-codex","thinking":{"type":"enabled","budget_tokens":32768},"input":"hi"}`, http.StatusForbidden)
+	// - /v1/responses/compact uses catalogFallback so suffix-pinned sk-low-only passes the 403 gate
+	reqCompact := httptest.NewRequest(http.MethodPost, "/v1/responses/compact", bytes.NewReader([]byte(`{"model":"test-filter-codex","input":"hi"}`)))
+	reqCompact.Header.Set("Content-Type", "application/json")
+	reqCompact.Header.Set("Authorization", "Bearer sk-low-only")
+	recCompact := httptest.NewRecorder()
+	srv.engine.ServeHTTP(recCompact, reqCompact)
+	if recCompact.Code == http.StatusForbidden {
+		t.Fatalf("POST /v1/responses/compact for sk-low-only unexpectedly returned 403: %s", recCompact.Body.String())
+	}
+
+	// 9. Grok shell model catalog filters reasoning_efforts per restricted API key!
+	reqGrok := httptest.NewRequest(http.MethodGet, "/v1/models", nil)
+	reqGrok.Header.Set("Authorization", "Bearer sk-low-only")
+	reqGrok.Header.Set("User-Agent", "grok-shell/0.2.119")
+	recGrok := httptest.NewRecorder()
+	srv.engine.ServeHTTP(recGrok, reqGrok)
+	if recGrok.Code != http.StatusOK {
+		t.Fatalf("grok /v1/models status = %d, want 200 (body=%s)", recGrok.Code, recGrok.Body.String())
+	}
+	var grokPayload struct {
+		Data []struct {
+			ID               string `json:"id"`
+			ReasoningEfforts []struct {
+				Value string `json:"value"`
+			} `json:"reasoning_efforts"`
+		} `json:"data"`
+	}
+	if err := json.Unmarshal(recGrok.Body.Bytes(), &grokPayload); err != nil {
+		t.Fatalf("unmarshal grok /v1/models: %v", err)
+	}
+	if len(grokPayload.Data) != 1 || grokPayload.Data[0].ID != "test-filter-codex" {
+		t.Fatalf("grok models for sk-low-only = %+v, want [test-filter-codex]", grokPayload.Data)
+	}
+	if len(grokPayload.Data[0].ReasoningEfforts) != 1 || grokPayload.Data[0].ReasoningEfforts[0].Value != "low" {
+		t.Fatalf("grok reasoning_efforts for sk-low-only = %+v, want [low]", grokPayload.Data[0].ReasoningEfforts)
+	}
+
+	// 10. /antigravity/callback rejects missing code/error, missing state, or bogus state with 400.
+	for _, cbURL := range []string{
+		"/antigravity/callback",
+		"/antigravity/callback?code=abc",
+		"/antigravity/callback?code=abc&state=nonexistent-session",
+	} {
+		reqCB := httptest.NewRequest(http.MethodGet, cbURL, nil)
+		recCB := httptest.NewRecorder()
+		srv.engine.ServeHTTP(recCB, reqCB)
+		if recCB.Code != http.StatusBadRequest {
+			t.Fatalf("GET %s status = %d, want 400 (body=%s)", cbURL, recCB.Code, recCB.Body.String())
+		}
+	}
+}
diff --git a/internal/api/handlers/management/auth_files.go b/internal/api/handlers/management/auth_files.go
