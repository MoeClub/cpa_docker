+func codexCatalogMappings(thinking *registry.ThinkingSupport) []registry.CodexLevelMapping {
+	if thinking == nil {
+		return nil
+	}
+	if len(thinking.Levels) == 0 {
+		return thinking.CodexLevelMap
+	}
+	if len(thinking.CodexLevelMap) == 0 {
+		identity := make([]registry.CodexLevelMapping, 0, len(thinking.Levels))
+		for _, level := range thinking.Levels {
+			identity = append(identity, registry.CodexLevelMapping{Codex: level, Level: level})
+		}
+		return identity
+	}
+
+	aliasesByLevel := make(map[string][]string, len(thinking.CodexLevelMap))
+	for _, mapping := range thinking.CodexLevelMap {
+		level := strings.ToLower(strings.TrimSpace(mapping.Level))
+		alias := strings.TrimSpace(mapping.Codex)
+		if level == "" || alias == "" {
+			continue
+		}
+		aliasesByLevel[level] = append(aliasesByLevel[level], alias)
+	}
+
+	mappings := make([]registry.CodexLevelMapping, 0, len(thinking.Levels)+len(thinking.CodexLevelMap))
+	seen := make(map[string]struct{}, len(thinking.Levels)+len(thinking.CodexLevelMap))
+	for _, rawLevel := range thinking.Levels {
+		level := strings.ToLower(strings.TrimSpace(rawLevel))
+		if level == "" {
+			continue
+		}
+		if aliases, exists := aliasesByLevel[level]; exists && len(aliases) > 0 {
+			for _, alias := range aliases {
+				if _, duplicate := seen[alias]; duplicate {
+					continue
+				}
+				seen[alias] = struct{}{}
+				mappings = append(mappings, registry.CodexLevelMapping{Codex: alias, Level: level})
+			}
+			continue
+		}
+		if _, duplicate := seen[level]; duplicate {
+			continue
+		}
+		seen[level] = struct{}{}
+		mappings = append(mappings, registry.CodexLevelMapping{Codex: level, Level: level})
+	}
+	return mappings
+}
+
+func catalogDefaultFromThinking(thinking *registry.ThinkingSupport) string {
+	if thinking == nil {
+		return ""
+	}
+	if len(thinking.CodexLevelMap) == 0 {
+		return thinking.DefaultLevel
+	}
+	defaultLevel := strings.ToLower(strings.TrimSpace(thinking.DefaultLevel))
+	if defaultLevel != "" {
+		for index := len(thinking.CodexLevelMap) - 1; index >= 0; index-- {
+			mapping := thinking.CodexLevelMap[index]
+			if strings.EqualFold(strings.TrimSpace(mapping.Level), defaultLevel) {
+				return mapping.Codex
+			}
+		}
+		for _, level := range thinking.Levels {
+			if strings.EqualFold(strings.TrimSpace(level), defaultLevel) {
+				return defaultLevel
+			}
+		}
+	}
+	return thinking.CodexLevelMap[len(thinking.CodexLevelMap)-1].Codex
+}
