+package models
+
+import (
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/registry"
+)
+
+func TestCodexClientModelsUsesConfiguredDefaultReasoningLevel(t *testing.T) {
+	resp := BuildResponseForClient([]map[string]any{{
+		"id": "ctyun-default-level-test",
+		"thinking": &registry.ThinkingSupport{
+			Levels:       []string{"low", "high", "max"},
+			DefaultLevel: "max",
+			CodexLevelMap: []registry.CodexLevelMapping{
+				{Codex: "xhigh", Level: "max"},
+				{Codex: "ultra", Level: "max"},
+			},
+		},
+	}}, nil, false, "0.163.0-alpha.10.2")
+
+	models, ok := resp["models"].([]map[string]any)
+	if !ok || len(models) != 1 {
+		t.Fatalf("models = %#v, want one model", resp["models"])
+	}
+	if got := stringModelValue(models[0], "default_reasoning_level"); got != "ultra" {
+		t.Fatalf("default_reasoning_level = %q, want ultra", got)
+	}
+
+	rawLevels, ok := models[0]["supported_reasoning_levels"].([]any)
+	if !ok || len(rawLevels) != 4 {
+		t.Fatalf("supported_reasoning_levels = %#v, want four levels", models[0]["supported_reasoning_levels"])
+	}
+	wantLevels := []string{"low", "high", "xhigh", "ultra"}
+	for i, want := range wantLevels {
+		levelEntry, ok := rawLevels[i].(map[string]any)
+		if !ok {
+			t.Fatalf("supported_reasoning_levels[%d] = %#v, want object", i, rawLevels[i])
+		}
+		if got := stringModelValue(levelEntry, "effort"); got != want {
+			t.Fatalf("supported_reasoning_levels[%d].effort = %q, want %q", i, got, want)
+		}
+	}
+}
+
+func TestCodexClientModelsPreservesUnmappedDefaultReasoningLevel(t *testing.T) {
+	resp := BuildResponseForClient([]map[string]any{{
+		"id": "ctyun-unmapped-default-level-test",
+		"thinking": &registry.ThinkingSupport{
+			Levels:       []string{"low", "high", "max"},
+			DefaultLevel: "low",
+			CodexLevelMap: []registry.CodexLevelMapping{
+				{Codex: "xhigh", Level: "max"},
+			},
+		},
+	}}, nil, false, "0.163.0-alpha.10.2")
+
+	models, ok := resp["models"].([]map[string]any)
+	if !ok || len(models) != 1 {
+		t.Fatalf("models = %#v, want one model", resp["models"])
+	}
+	if got := stringModelValue(models[0], "default_reasoning_level"); got != "low" {
+		t.Fatalf("default_reasoning_level = %q, want low", got)
+	}
+}
