+// ctyunReasoningTestBaseURL keeps the real CTYun domain so the domain-based
+// endpoint detection under test is exercised; requests are routed to the local
+// fixture server by ctyunReasoningTestContext.
+const ctyunReasoningTestBaseURL = "https://eaichat.ctyun.cn/ai/platform/v2/cp"
+
+func ctyunReasoningTestContext(t *testing.T, serverURL string) context.Context {
+	t.Helper()
+	target, errParse := url.Parse(serverURL)
+	if errParse != nil {
+		t.Fatalf("parse fixture server URL: %v", errParse)
+	}
+	roundTripper := roundTripperFunc(func(req *http.Request) (*http.Response, error) {
+		clone := req.Clone(req.Context())
+		clone.URL.Scheme = target.Scheme
+		clone.URL.Host = target.Host
+		clone.Host = target.Host
+		return http.DefaultTransport.RoundTrip(clone)
+	})
+	return context.WithValue(context.Background(), "cliproxy.roundtripper", http.RoundTripper(roundTripper))
+}
+
+func TestOpenAICompatCTYunReasoningLengthRepairsInsideOneResponsesStream(t *testing.T) {
+	var (
+		mu     sync.Mutex
+		bodies [][]byte
+	)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		body, _ := io.ReadAll(r.Body)
+		mu.Lock()
+		bodies = append(bodies, body)
+		attempt := len(bodies)
+		mu.Unlock()
+
+		w.Header().Set("Content-Type", "text/event-stream")
+		if attempt == 1 {
+			_, _ = io.WriteString(w, strings.Join([]string{
+				`data: {"id":"first","object":"chat.completion.chunk","model":"deepseek-v4.1-flash","choices":[{"index":0,"delta":{"role":"assistant"},"finish_reason":null}]}`,
+				`data: {"id":"first","object":"chat.completion.chunk","model":"deepseek-v4.1-flash","choices":[{"index":0,"delta":{"reasoning_content":"derive the invariant and keep the unresolved final step"},"finish_reason":null}]}`,
+				`data: {"id":"first","object":"chat.completion.chunk","model":"deepseek-v4.1-flash","choices":[{"index":0,"delta":{},"finish_reason":"length"}],"usage":{"prompt_tokens":10,"completion_tokens":20,"total_tokens":30}}`,
+				`data: [DONE]`,
+			}, "\n\n")+"\n\n")
+			return
+		}
+		_, _ = io.WriteString(w, strings.Join([]string{
+			`data: {"id":"second","object":"chat.completion.chunk","model":"deepseek-v4.1-flash","choices":[{"index":0,"delta":{"role":"assistant"},"finish_reason":null}]}`,
+			`data: {"id":"second","object":"chat.completion.chunk","model":"deepseek-v4.1-flash","choices":[{"index":0,"delta":{"reasoning_content":"complete the final step"},"finish_reason":null}]}`,
+			`data: {"id":"second","object":"chat.completion.chunk","model":"deepseek-v4.1-flash","choices":[{"index":0,"delta":{"content":"The answer is 21."},"finish_reason":null}]}`,
+			`data: {"id":"second","object":"chat.completion.chunk","model":"deepseek-v4.1-flash","choices":[{"index":0,"delta":{},"finish_reason":"stop"}],"usage":{"prompt_tokens":40,"completion_tokens":5,"total_tokens":45}}`,
+			`data: [DONE]`,
+		}, "\n\n")+"\n\n")
+	}))
+	defer server.Close()
+
+	cfg := &config.Config{}
+	cfg.Payload.Override = []config.PayloadRule{{
+		Models: []config.PayloadModelRule{{Name: "deepseek-v4.1-flash"}},
+		Params: map[string]any{"audit.-1": "once"},
+	}}
+	executor := NewOpenAICompatExecutor("openai-compatibility", cfg)
+	auth := &cliproxyauth.Auth{Attributes: map[string]string{
+		"base_url": ctyunReasoningTestBaseURL,
+		"api_key":  "fixture",
+	}}
+	payload := []byte(`{"model":"deepseek-v4.1-flash","input":[{"role":"user","content":[{"type":"input_text","text":"solve"}]}],"stream":true,"max_output_tokens":64}`)
+	result, errExecute := executor.ExecuteStream(ctyunReasoningTestContext(t, server.URL), auth, cliproxyexecutor.Request{
+		Model: "deepseek-v4.1-flash", Payload: payload,
+	}, cliproxyexecutor.Options{
+		SourceFormat:    sdktranslator.FormatOpenAIResponse,
+		ResponseFormat:  sdktranslator.FormatOpenAIResponse,
+		OriginalRequest: payload,
+		Stream:          true,
+	})
+	if errExecute != nil {
+		t.Fatal(errExecute)
+	}
+	var downstream strings.Builder
+	for chunk := range result.Chunks {
+		if chunk.Err != nil {
+			t.Fatalf("stream error: %v", chunk.Err)
+		}
+		downstream.Write(chunk.Payload)
+	}
+
+	stream := downstream.String()
+	if strings.Contains(stream, "event: response.incomplete") {
+		t.Fatalf("intermediate incomplete leaked downstream: %s", stream)
+	}
+	if strings.Count(stream, "event: response.completed") != 1 {
+		t.Fatalf("completed count mismatch: %s", stream)
+	}
+	if !strings.Contains(stream, "The answer is 21.") {
+		t.Fatalf("final answer missing: %s", stream)
+	}
+
+	mu.Lock()
+	defer mu.Unlock()
+	if len(bodies) != 2 {
+		t.Fatalf("upstream requests = %d, want 2", len(bodies))
+	}
+	continuation := bodies[1]
+	if got := gjson.GetBytes(continuation, "messages.#").Int(); got != 3 {
+		t.Fatalf("continuation messages = %d, want 3: %s", got, continuation)
+	}
+	if got := gjson.GetBytes(continuation, "messages.1.reasoning_content").String(); got != "derive the invariant and keep the unresolved final step" {
+		t.Fatalf("continuation checkpoint = %q: %s", got, continuation)
+	}
+	if got := gjson.GetBytes(continuation, "max_tokens").Int(); got != 64 {
+		t.Fatalf("continuation max_tokens = %d, want 64: %s", got, continuation)
+	}
+	if got := gjson.GetBytes(continuation, "audit.#").Int(); got != 1 {
+		t.Fatalf("payload override applied %d times, want once: %s", got, continuation)
+	}
+}
