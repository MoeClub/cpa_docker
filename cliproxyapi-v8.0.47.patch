diff --git a/internal/runtime/executor/helps/ctyun_reasoning_repair.go b/internal/runtime/executor/helps/ctyun_reasoning_repair.go
new file mode 100644
index 0000000..1f56e39
--- /dev/null
+++ b/internal/runtime/executor/helps/ctyun_reasoning_repair.go
@@ -0,0 +1,617 @@
+package helps
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/url"
+	"strings"
+	"sync"
+
+	"github.com/tidwall/gjson"
+	"github.com/tidwall/sjson"
+)
+
+const (
+	ctyunReasoningRepairAttempts = 2
+	ctyunReasoningLoopAnchor     = 64
+	ctyunReasoningHoldback       = 8192
+	ctyunReasoningScannerMax     = 52_428_800
+)
+
+// CTYunReasoningContinuation starts a hidden continuation request from a
+// de-duplicated reasoning checkpoint. repairAttempt starts at one.
+type CTYunReasoningContinuation func(ctx context.Context, checkpoint string, repairAttempt int) (io.ReadCloser, error)
+
+type ctyunRepairReadCloser struct {
+	*io.PipeReader
+	cancel context.CancelFunc
+	once   sync.Once
+}
+
+func (r *ctyunRepairReadCloser) Close() error {
+	if r == nil {
+		return nil
+	}
+	r.once.Do(r.cancel)
+	return r.PipeReader.Close()
+}
+
+// IsCTYunOpenAICompatibilityBaseURL reports whether baseURL targets CTYun's
+// CP OpenAI-compatible endpoint. Detection is domain-only so gateways that
+// merely reuse the upstream path are not treated as CTYun.
+func IsCTYunOpenAICompatibilityBaseURL(baseURL string) bool {
+	parsed, errParse := url.Parse(strings.TrimSpace(baseURL))
+	if errParse != nil {
+		return false
+	}
+	return strings.EqualFold(parsed.Hostname(), "eaichat.ctyun.cn")
+}
+
+// BuildCTYunReasoningContinuationPayload appends one assistant checkpoint and
+// one internal continuation instruction to an already translated Chat
+// Completions payload. Payload rules must be applied after this function.
+func BuildCTYunReasoningContinuationPayload(base []byte, checkpoint string, repairAttempt int) ([]byte, error) {
+	if !gjson.GetBytes(base, "messages").IsArray() {
+		return nil, errors.New("ctyun reasoning continuation requires a messages array")
+	}
+	checkpoint = strings.TrimSpace(checkpoint)
+	if checkpoint == "" {
+		return nil, errors.New("ctyun reasoning continuation requires a non-empty checkpoint")
+	}
+	if repairAttempt > 1 {
+		// The first checkpoint continuation did not converge. Do not feed the
+		// growing reasoning back again: replace it with a compact reset marker so
+		// the original conversation remains intact without reinforcing the loop.
+		checkpoint = "Earlier reasoning attempts were incomplete and must not be continued or repeated."
+	}
+
+	assistant, errMarshal := json.Marshal(map[string]any{
+		"role":              "assistant",
+		"content":           "",
+		"reasoning_content": checkpoint,
+	})
+	if errMarshal != nil {
+		return nil, fmt.Errorf("marshal CTYun reasoning checkpoint: %w", errMarshal)
+	}
+	instruction := "Continue from the reasoning checkpoint without restarting or repeating it. Resolve the remaining work and now produce the final answer or required tool call."
+	if repairAttempt > 1 {
+		instruction = "The previous reasoning did not converge. Discard it, solve the original request with a different concise approach, and now produce the final answer or required tool call. Do not narrate further analysis."
+	}
+	user, errMarshal := json.Marshal(map[string]any{"role": "user", "content": instruction})
+	if errMarshal != nil {
+		return nil, fmt.Errorf("marshal CTYun continuation instruction: %w", errMarshal)
+	}
+
+	out, errSet := sjson.SetRawBytes(bytes.Clone(base), "messages.-1", assistant)
+	if errSet != nil {
+		return nil, fmt.Errorf("append CTYun reasoning checkpoint: %w", errSet)
+	}
+	out, errSet = sjson.SetRawBytes(out, "messages.-1", user)
+	if errSet != nil {
+		return nil, fmt.Errorf("append CTYun continuation instruction: %w", errSet)
+	}
+	return out, nil
+}
+
+// NewCTYunReasoningRepairStream combines reasoning-only truncated CTYun
+// streams into one downstream stream. A reasoning tail is held back so
+// repeated loops can be removed before they are visible.
+func NewCTYunReasoningRepairStream(ctx context.Context, initial io.ReadCloser, continueRequest CTYunReasoningContinuation) io.ReadCloser {
+	if initial == nil || continueRequest == nil {
+		return initial
+	}
+	streamCtx, cancel := context.WithCancel(ctx)
+	reader, writer := io.Pipe()
+	out := &ctyunRepairReadCloser{PipeReader: reader, cancel: cancel}
+	go func() {
+		defer cancel()
+		state := &ctyunReasoningRepairState{}
+		source := initial
+		for repairs := 0; ; {
+			result := processCTYunReasoningAttempt(streamCtx, source, writer, state, repairs)
+			_ = source.Close()
+			if result.err != nil {
+				_ = writer.CloseWithError(result.err)
+				return
+			}
+			if result.terminal {
+				_ = writer.Close()
+				return
+			}
+			if !result.repair || repairs >= ctyunReasoningRepairAttempts {
+				if errFallback := state.emitIncomplete(writer); errFallback != nil {
+					_ = writer.CloseWithError(errFallback)
+				} else {
+					_ = writer.Close()
+				}
+				return
+			}
+
+			state.finishAttempt()
+			repairs++
+			next, errContinue := continueRequest(streamCtx, state.checkpoint(), repairs)
+			if errContinue != nil || next == nil {
+				if errFallback := state.emitIncomplete(writer); errFallback != nil {
+					_ = writer.CloseWithError(errFallback)
+				} else {
+					_ = writer.Close()
+				}
+				return
+			}
+			source = next
+		}
+	}()
+	return out
+}
+
+type ctyunReasoningAttemptResult struct {
+	repair   bool
+	terminal bool
+	err      error
+}
+
+type ctyunReasoningRepairState struct {
+	completedReasoning []string
+	currentReasoning   strings.Builder
+	reasoningTemplate  []byte
+	finishTemplate     []byte
+	roleEmitted        bool
+	visibleOutput      bool
+	flushedReasoning   bool
+	emittedReasoning   string
+	usage              ctyunUsageAccumulator
+}
+
+func (s *ctyunReasoningRepairState) appendReasoning(text string) bool {
+	if text == "" {
+		return false
+	}
+	s.currentReasoning.WriteString(text)
+	_, removed := collapseRepeatedReasoning(s.currentReasoning.String())
+	return removed > 0
+}
+
+func (s *ctyunReasoningRepairState) finishAttempt() {
+	current, _ := collapseRepeatedReasoning(s.currentReasoning.String())
+	if current != "" {
+		s.completedReasoning = append(s.completedReasoning, current)
+	}
+	s.currentReasoning.Reset()
+}
+
+func (s *ctyunReasoningRepairState) checkpoint() string {
+	parts := append([]string(nil), s.completedReasoning...)
+	current, _ := collapseRepeatedReasoning(s.currentReasoning.String())
+	if current != "" {
+		parts = append(parts, current)
+	}
+	checkpoint := ""
+	for _, part := range parts {
+		checkpoint = mergeReasoningOverlap(checkpoint, part)
+	}
+	checkpoint, _ = collapseRepeatedReasoning(checkpoint)
+	return strings.TrimSpace(checkpoint)
+}
+
+func (s *ctyunReasoningRepairState) emitReasoning(writer io.Writer, final bool) error {
+	if s.flushedReasoning {
+		return nil
+	}
+	checkpoint := s.checkpoint()
+	if checkpoint == "" || len(s.reasoningTemplate) == 0 {
+		s.flushedReasoning = final
+		return nil
+	}
+	checkpointRunes := []rune(checkpoint)
+	emittedRunes := []rune(s.emittedReasoning)
+	if !strings.HasPrefix(checkpoint, s.emittedReasoning) {
+		// A loop longer than the holdback may overlap text already emitted. It
+		// cannot be retracted, so retain that finite prefix while still removing
+		// all later copies from the continuation checkpoint.
+		common := commonReasoningPrefix(emittedRunes, checkpointRunes)
+		checkpointRunes = append(append([]rune(nil), emittedRunes...), checkpointRunes[common:]...)
+	}
+	end := len(checkpointRunes)
+	if !final {
+		end -= ctyunReasoningHoldback
+		if end <= len(emittedRunes) {
+			return nil
+		}
+	}
+	if end <= len(emittedRunes) {
+		s.flushedReasoning = final
+		return nil
+	}
+	segment := string(checkpointRunes[len(emittedRunes):end])
+	payload := bytes.Clone(s.reasoningTemplate)
+	delta, errMarshal := json.Marshal(map[string]any{"reasoning_content": segment})
+	if errMarshal != nil {
+		return errMarshal
+	}
+	payload, _ = sjson.SetRawBytes(payload, "choices.0.delta", delta)
+	payload, _ = sjson.SetRawBytes(payload, "choices.0.finish_reason", []byte("null"))
+	payload, _ = sjson.DeleteBytes(payload, "usage")
+	if errFrame := writeCTYunDataFrame(writer, payload); errFrame != nil {
+		return errFrame
+	}
+	s.emittedReasoning = string(checkpointRunes[:end])
+	s.flushedReasoning = final
+	return nil
+}
+
+func (s *ctyunReasoningRepairState) emitIncomplete(writer io.Writer) error {
+	if errReasoning := s.emitReasoning(writer, true); errReasoning != nil {
+		return errReasoning
+	}
+	payload := bytes.Clone(s.finishTemplate)
+	if len(payload) == 0 {
+		payload = bytes.Clone(s.reasoningTemplate)
+		payload, _ = sjson.SetRawBytes(payload, "choices.0.delta", []byte(`{}`))
+		payload, _ = sjson.SetBytes(payload, "choices.0.finish_reason", "length")
+	}
+	payload = s.usage.apply(payload)
+	if errFrame := writeCTYunDataFrame(writer, payload); errFrame != nil {
+		return errFrame
+	}
+	return writeCTYunDone(writer)
+}
+
+func processCTYunReasoningAttempt(ctx context.Context, source io.Reader, writer io.Writer, state *ctyunReasoningRepairState, repairs int) ctyunReasoningAttemptResult {
+	scanner := bufio.NewScanner(source)
+	scanner.Buffer(nil, ctyunReasoningScannerMax)
+	var dataLines [][]byte
+	pendingRepair := false
+	var pendingFinal []byte
+
+	processPayload := func(payload []byte) (stop bool, result ctyunReasoningAttemptResult) {
+		payload = bytes.TrimSpace(payload)
+		if bytes.Equal(payload, []byte("[DONE]")) {
+			if pendingRepair {
+				return true, ctyunReasoningAttemptResult{repair: true}
+			}
+			if len(pendingFinal) == 0 && !state.visibleOutput && state.checkpoint() != "" {
+				if repairs < ctyunReasoningRepairAttempts {
+					return true, ctyunReasoningAttemptResult{repair: true}
+				}
+				return true, ctyunReasoningAttemptResult{terminal: true, err: state.emitIncomplete(writer)}
+			}
+			if len(pendingFinal) > 0 {
+				if errReasoning := state.emitReasoning(writer, true); errReasoning != nil {
+					return true, ctyunReasoningAttemptResult{err: errReasoning}
+				}
+				if errFrame := writeCTYunDataFrame(writer, state.usage.apply(pendingFinal)); errFrame != nil {
+					return true, ctyunReasoningAttemptResult{err: errFrame}
+				}
+			}
+			if errDone := writeCTYunDone(writer); errDone != nil {
+				return true, ctyunReasoningAttemptResult{err: errDone}
+			}
+			return true, ctyunReasoningAttemptResult{terminal: true}
+		}
+		if !json.Valid(payload) {
+			return true, ctyunReasoningAttemptResult{err: errors.New("invalid CTYun SSE data frame")}
+		}
+
+		state.usage.observe(payload)
+		if pendingRepair || len(pendingFinal) > 0 {
+			return false, ctyunReasoningAttemptResult{}
+		}
+
+		delta := gjson.GetBytes(payload, "choices.0.delta")
+		reasoning := delta.Get("reasoning_content").String()
+		if reasoning == "" {
+			reasoning = delta.Get("reasoning").String()
+		}
+		hasContent := delta.Get("content").String() != "" || delta.Get("refusal").String() != ""
+		hasTools := len(delta.Get("tool_calls").Array()) > 0
+		if reasoning != "" && !state.flushedReasoning {
+			if len(state.reasoningTemplate) == 0 {
+				state.reasoningTemplate = bytes.Clone(payload)
+			}
+			looping := state.appendReasoning(reasoning)
+			stripped, roleOnly := stripCTYunReasoningDelta(payload)
+			if roleOnly && !state.roleEmitted {
+				if errFrame := writeCTYunDataFrame(writer, stripped); errFrame != nil {
+					return true, ctyunReasoningAttemptResult{err: errFrame}
+				}
+				state.roleEmitted = true
+			}
+			if looping && !hasContent && !hasTools {
+				if repairs < ctyunReasoningRepairAttempts {
+					return true, ctyunReasoningAttemptResult{repair: true}
+				}
+				return true, ctyunReasoningAttemptResult{terminal: true, err: state.emitIncomplete(writer)}
+			}
+			if !hasContent && !hasTools {
+				if errReasoning := state.emitReasoning(writer, false); errReasoning != nil {
+					return true, ctyunReasoningAttemptResult{err: errReasoning}
+				}
+				return false, ctyunReasoningAttemptResult{}
+			}
+			payload = stripped
+		}
+
+		if hasContent || hasTools {
+			if errReasoning := state.emitReasoning(writer, true); errReasoning != nil {
+				return true, ctyunReasoningAttemptResult{err: errReasoning}
+			}
+			state.visibleOutput = true
+		}
+
+		finishReason := strings.TrimSpace(gjson.GetBytes(payload, "choices.0.finish_reason").String())
+		if finishReason != "" {
+			state.finishTemplate = bytes.Clone(payload)
+			if finishReason == "length" && !state.visibleOutput && state.checkpoint() != "" {
+				if repairs < ctyunReasoningRepairAttempts {
+					pendingRepair = true
+					return false, ctyunReasoningAttemptResult{}
+				}
+				pendingFinal = bytes.Clone(payload)
+				return false, ctyunReasoningAttemptResult{}
+			}
+			pendingFinal = bytes.Clone(payload)
+			return false, ctyunReasoningAttemptResult{}
+		}
+
+		if len(gjson.GetBytes(payload, "choices").Array()) == 0 && gjson.GetBytes(payload, "usage").Exists() {
+			return false, ctyunReasoningAttemptResult{}
+		}
+		if delta.Get("role").String() != "" && !state.roleEmitted {
+			state.roleEmitted = true
+		} else if delta.Get("role").String() != "" && repairs > 0 {
+			return false, ctyunReasoningAttemptResult{}
+		}
+		if errFrame := writeCTYunDataFrame(writer, payload); errFrame != nil {
+			return true, ctyunReasoningAttemptResult{err: errFrame}
+		}
+		return false, ctyunReasoningAttemptResult{}
+	}
+
+	processFrame := func() (bool, ctyunReasoningAttemptResult) {
+		if len(dataLines) == 0 {
+			return false, ctyunReasoningAttemptResult{}
+		}
+		payload := bytes.TrimSpace(bytes.Join(dataLines, []byte("\n")))
+		dataLines = nil
+		return processPayload(payload)
+	}
+
+	for scanner.Scan() {
+		select {
+		case <-ctx.Done():
+			return ctyunReasoningAttemptResult{err: ctx.Err()}
+		default:
+		}
+		line := bytes.TrimSpace(scanner.Bytes())
+		if len(line) == 0 {
+			if stop, result := processFrame(); stop {
+				return result
+			}
+			continue
+		}
+		if bytes.HasPrefix(line, []byte("data:")) {
+			dataLines = append(dataLines, bytes.Clone(bytes.TrimSpace(line[len("data:"):])))
+		}
+	}
+	if len(dataLines) > 0 {
+		if stop, result := processFrame(); stop {
+			return result
+		}
+	}
+	if pendingRepair || (!state.visibleOutput && state.checkpoint() != "") {
+		if repairs < ctyunReasoningRepairAttempts {
+			return ctyunReasoningAttemptResult{repair: true}
+		}
+		return ctyunReasoningAttemptResult{terminal: true, err: state.emitIncomplete(writer)}
+	}
+	if len(pendingFinal) > 0 {
+		if errReasoning := state.emitReasoning(writer, true); errReasoning != nil {
+			return ctyunReasoningAttemptResult{err: errReasoning}
+		}
+		if errFrame := writeCTYunDataFrame(writer, state.usage.apply(pendingFinal)); errFrame != nil {
+			return ctyunReasoningAttemptResult{err: errFrame}
+		}
+		if errDone := writeCTYunDone(writer); errDone != nil {
+			return ctyunReasoningAttemptResult{err: errDone}
+		}
+		return ctyunReasoningAttemptResult{terminal: true}
+	}
+	if errScan := scanner.Err(); errScan != nil {
+		return ctyunReasoningAttemptResult{err: errScan}
+	}
+	return ctyunReasoningAttemptResult{err: io.ErrUnexpectedEOF}
+}
+
+func stripCTYunReasoningDelta(payload []byte) ([]byte, bool) {
+	out, _ := sjson.DeleteBytes(bytes.Clone(payload), "choices.0.delta.reasoning_content")
+	out, _ = sjson.DeleteBytes(out, "choices.0.delta.reasoning")
+	delta := gjson.GetBytes(out, "choices.0.delta")
+	roleOnly := delta.Get("role").String() != "" && len(delta.Map()) == 1
+	return out, roleOnly
+}
+
+func writeCTYunDataFrame(writer io.Writer, payload []byte) error {
+	_, errWrite := fmt.Fprintf(writer, "data: %s\n\n", payload)
+	return errWrite
+}
+
+func writeCTYunDone(writer io.Writer) error {
+	_, errWrite := io.WriteString(writer, "data: [DONE]\n\n")
+	return errWrite
+}
+
+type ctyunUsageAccumulator struct {
+	value map[string]any
+}
+
+func (a *ctyunUsageAccumulator) observe(payload []byte) {
+	usageNode := gjson.GetBytes(payload, "usage")
+	if !usageNode.Exists() || usageNode.Type != gjson.JSON {
+		return
+	}
+	var incoming map[string]any
+	if errUnmarshal := json.Unmarshal([]byte(usageNode.Raw), &incoming); errUnmarshal != nil {
+		return
+	}
+	if a.value == nil {
+		a.value = make(map[string]any, len(incoming))
+	}
+	mergeCTYunUsage(a.value, incoming)
+}
+
+func (a *ctyunUsageAccumulator) apply(payload []byte) []byte {
+	if len(a.value) == 0 || len(payload) == 0 {
+		return payload
+	}
+	usageJSON, errMarshal := json.Marshal(a.value)
+	if errMarshal != nil {
+		return payload
+	}
+	out, errSet := sjson.SetRawBytes(bytes.Clone(payload), "usage", usageJSON)
+	if errSet != nil {
+		return payload
+	}
+	return out
+}
+
+func mergeCTYunUsage(dst, src map[string]any) {
+	for key, incoming := range src {
+		switch typed := incoming.(type) {
+		case float64:
+			if existing, ok := dst[key].(float64); ok {
+				dst[key] = existing + typed
+			} else {
+				dst[key] = typed
+			}
+		case map[string]any:
+			nested, ok := dst[key].(map[string]any)
+			if !ok {
+				nested = make(map[string]any, len(typed))
+				dst[key] = nested
+			}
+			mergeCTYunUsage(nested, typed)
+		default:
+			dst[key] = incoming
+		}
+	}
+}
+
+func collapseRepeatedReasoning(text string) (string, int) {
+	source := []rune(text)
+	if len(source) < ctyunReasoningLoopAnchor*3 {
+		return text, 0
+	}
+	out := make([]rune, 0, len(source))
+	positions := make(map[uint64][]int)
+	removed := 0
+	for index := 0; index < len(source); {
+		if index+ctyunReasoningLoopAnchor <= len(source) {
+			hash := hashReasoningRunes(source[index : index+ctyunReasoningLoopAnchor])
+			candidates := positions[hash]
+			matchedEnd := index
+			for candidateIndex := len(candidates) - 1; candidateIndex >= 0; candidateIndex-- {
+				previous := candidates[candidateIndex]
+				period := index - previous
+				if period < ctyunReasoningLoopAnchor || index+period+ctyunReasoningLoopAnchor > len(source) {
+					continue
+				}
+				end := index
+				for end < len(source) && source[end] == source[previous+(end-index)%period] {
+					end++
+				}
+				if end-index >= period+ctyunReasoningLoopAnchor {
+					matchedEnd = end
+					break
+				}
+			}
+			if matchedEnd > index {
+				removed += matchedEnd - index
+				index = matchedEnd
+				continue
+			}
+			positions[hash] = appendLimitedReasoningPosition(candidates, index)
+		}
+		out = append(out, source[index])
+		index++
+	}
+	return string(out), removed
+}
+
+func appendLimitedReasoningPosition(existing []int, position int) []int {
+	const maxCandidates = 8
+	if len(existing) >= maxCandidates {
+		copy(existing, existing[len(existing)-maxCandidates+1:])
+		existing = existing[:maxCandidates-1]
+	}
+	return append(existing, position)
+}
+
+func hashReasoningRunes(value []rune) uint64 {
+	const (
+		offset = uint64(1469598103934665603)
+		prime  = uint64(1099511628211)
+	)
+	hash := offset
+	for _, current := range value {
+		hash ^= uint64(current)
+		hash *= prime
+	}
+	return hash
+}
+
+func mergeReasoningOverlap(previous, next string) string {
+	if previous == "" {
+		return next
+	}
+	if next == "" {
+		return previous
+	}
+	left := []rune(previous)
+	right := []rune(next)
+	sequence := make([]int64, 0, len(right)+1+len(left))
+	for _, current := range right {
+		sequence = append(sequence, int64(current))
+	}
+	sequence = append(sequence, -1)
+	for _, current := range left {
+		sequence = append(sequence, int64(current))
+	}
+	prefix := make([]int, len(sequence))
+	for index := 1; index < len(sequence); index++ {
+		candidate := prefix[index-1]
+		for candidate > 0 && sequence[index] != sequence[candidate] {
+			candidate = prefix[candidate-1]
+		}
+		if sequence[index] == sequence[candidate] {
+			candidate++
+		}
+		prefix[index] = candidate
+	}
+	overlap := prefix[len(prefix)-1]
+	if overlap < ctyunReasoningLoopAnchor || overlap > len(right) {
+		separator := "\n"
+		if len(left) > 0 && len(right) > 0 && (left[len(left)-1] == '\n' || right[0] == '\n') {
+			separator = ""
+		}
+		return previous + separator + next
+	}
+	return string(append(left, right[overlap:]...))
+}
+
+func commonReasoningPrefix(left, right []rune) int {
+	limit := len(left)
+	if len(right) < limit {
+		limit = len(right)
+	}
+	for index := 0; index < limit; index++ {
+		if left[index] != right[index] {
+			return index
+		}
+	}
+	return limit
+}
