+func TestCTYunReasoningRepairStreamContinuationFailureFallsBackToIncomplete(t *testing.T) {
+	first := strings.Join([]string{
+		`data: {"id":"first","object":"chat.completion.chunk","model":"deepseek-v4.1-flash","choices":[{"index":0,"delta":{"role":"assistant"},"finish_reason":null}]}`,
+		`data: {"id":"first","object":"chat.completion.chunk","model":"deepseek-v4.1-flash","choices":[{"index":0,"delta":{"reasoning_content":"checkpoint before failed continuation"},"finish_reason":null}]}`,
+		`data: {"id":"first","object":"chat.completion.chunk","model":"deepseek-v4.1-flash","choices":[{"index":0,"delta":{},"finish_reason":"length"}]}`,
+		`data: [DONE]`,
+	}, "\n\n") + "\n\n"
+	repaired := NewCTYunReasoningRepairStream(context.Background(), io.NopCloser(strings.NewReader(first)), func(context.Context, string, int) (io.ReadCloser, error) {
+		return nil, errors.New("continuation unavailable")
+	})
+	output, errRead := io.ReadAll(repaired)
+	if errRead != nil {
+		t.Fatal(errRead)
+	}
+	stream := string(output)
+	if strings.Count(stream, `"finish_reason":"length"`) != 1 || strings.Count(stream, "data: [DONE]") != 1 {
+		t.Fatalf("continuation failure did not fall back to one incomplete terminal: %s", stream)
+	}
+}
+
+func lastCTYunJSONFrame(stream []byte) []byte {
+	var last []byte
+	for _, frame := range strings.Split(string(stream), "\n\n") {
+		data, ok := strings.CutPrefix(strings.TrimSpace(frame), "data: ")
+		if ok && data != "[DONE]" && gjson.Valid(data) {
+			last = []byte(data)
+		}
+	}
+	return last
+}
+
+func quotedJSON(value string) string {
+	encoded, _ := json.Marshal(value)
+	return string(encoded)
+}
