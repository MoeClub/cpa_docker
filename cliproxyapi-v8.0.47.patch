+	repaired := NewCTYunReasoningRepairStream(context.Background(), io.NopCloser(strings.NewReader(first)), func(_ context.Context, checkpoint string, _ int) (io.ReadCloser, error) {
+		continuations++
+		if checkpoint != "checkpoint before transport EOF" {
+			t.Fatalf("checkpoint = %q", checkpoint)
+		}
+		return io.NopCloser(strings.NewReader(second)), nil
+	})
+	output, errRead := io.ReadAll(repaired)
+	if errRead != nil {
+		t.Fatal(errRead)
+	}
+	if continuations != 1 || !strings.Contains(string(output), "recovered") {
+		t.Fatalf("reasoning-only EOF was not repaired: continuations=%d stream=%s", continuations, output)
+	}
+}
