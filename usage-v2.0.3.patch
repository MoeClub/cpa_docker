diff --git a/internal/repository/pricing_legacy_functions_purego.go b/internal/repository/pricing_legacy_functions_purego.go
new file mode 100644
index 0000000..63dac42
--- /dev/null
+++ b/internal/repository/pricing_legacy_functions_purego.go
@@ -0,0 +1,62 @@
+//go:build !sqlite_trace
+
+package repository
+
+import (
+	"database/sql/driver"
+	"fmt"
+	"time"
+
+	"cpa-usage-keeper/internal/entities"
+	"cpa-usage-keeper/internal/overview"
+	"cpa-usage-keeper/internal/sqlite"
+	"cpa-usage-keeper/internal/timeutil"
+	"gorm.io/gorm"
+	moderncsqlite "modernc.org/sqlite"
+)
+
+func init() {
+	if err := sqlite.RegisterDeterministicScalarFunction("pricing_overview_bucket", 2, pricingOverviewBucketFunction); err != nil {
+		panic(err)
+	}
+	if err := sqlite.RegisterDeterministicScalarFunction("pricing_overview_instant", 1, pricingOverviewInstantFunction); err != nil {
+		panic(err)
+	}
+}
+
+func registerPricingLegacyFunctions(*gorm.DB) error {
+	return nil
+}
+
+func pricingOverviewBucketFunction(_ *moderncsqlite.FunctionContext, args []driver.Value) (driver.Value, error) {
+	value, ok := args[0].(string)
+	if !ok {
+		return nil, fmt.Errorf("pricing_overview_bucket expects TEXT, got %T", args[0])
+	}
+	daily, ok := args[1].(int64)
+	if !ok {
+		return nil, fmt.Errorf("pricing_overview_bucket expects INTEGER, got %T", args[1])
+	}
+	timestamp, err := timeutil.ParseStorageTime(value)
+	if err != nil {
+		return nil, err
+	}
+	hour, day := overview.BucketKeysForEvent(entities.UsageEvent{Timestamp: timestamp})
+	bucket := hour.BucketStart
+	if daily != 0 {
+		bucket = day.BucketStart
+	}
+	return bucket.UTC().Format(time.RFC3339Nano), nil
+}
+
+func pricingOverviewInstantFunction(_ *moderncsqlite.FunctionContext, args []driver.Value) (driver.Value, error) {
+	value, ok := args[0].(string)
+	if !ok {
+		return nil, fmt.Errorf("pricing_overview_instant expects TEXT, got %T", args[0])
+	}
+	timestamp, err := timeutil.ParseStorageTime(value)
+	if err != nil {
+		return nil, err
+	}
+	return timestamp.UTC().Format(time.RFC3339Nano), nil
+}
diff --git a/internal/repository/pricing_legacy_functions_trace.go b/internal/repository/pricing_legacy_functions_trace.go
new file mode 100644
index 0000000..5bd2309
--- /dev/null
+++ b/internal/repository/pricing_legacy_functions_trace.go
@@ -0,0 +1,50 @@
+//go:build sqlite_trace
+
+package repository
+
+import (
+	"database/sql"
+	"fmt"
+	"time"
+
+	"cpa-usage-keeper/internal/entities"
+	"cpa-usage-keeper/internal/overview"
+	"cpa-usage-keeper/internal/timeutil"
+	"github.com/mattn/go-sqlite3"
+	"gorm.io/gorm"
+)
+
+func registerPricingLegacyFunctions(db *gorm.DB) error {
+	conn, ok := db.Statement.ConnPool.(*sql.Conn)
+	if !ok {
+		return fmt.Errorf("pricing M6 requires a pinned SQL connection")
+	}
+	return conn.Raw(func(raw any) error {
+		sqliteConn, ok := raw.(*sqlite3.SQLiteConn)
+		if !ok {
+			return fmt.Errorf("pricing M6 requires a SQLite connection")
+		}
+		if err := sqliteConn.RegisterFunc("pricing_overview_bucket", func(value string, daily bool) (string, error) {
+			timestamp, err := timeutil.ParseStorageTime(value)
+			if err != nil {
+				return "", err
+			}
+			hour, day := overview.BucketKeysForEvent(entities.UsageEvent{Timestamp: timestamp})
+			bucket := hour.BucketStart
+			if daily {
+				bucket = day.BucketStart
+			}
+			return bucket.UTC().Format(time.RFC3339Nano), nil
+		}, true); err != nil {
+			return err
+		}
+		// 已存桶是写入公式产出的 instant；午夜跳时可能使它落在前一日，不能再次归日。
+		return sqliteConn.RegisterFunc("pricing_overview_instant", func(value string) (string, error) {
+			timestamp, err := timeutil.ParseStorageTime(value)
+			if err != nil {
+				return "", err
+			}
+			return timestamp.UTC().Format(time.RFC3339Nano), nil
+		}, true)
+	})
+}
