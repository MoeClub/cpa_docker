diff --git a/internal/sqlite/sqlite_purego.go b/internal/sqlite/sqlite_purego.go
new file mode 100644
index 0000000..e0a1004
--- /dev/null
+++ b/internal/sqlite/sqlite_purego.go
@@ -0,0 +1,40 @@
+//go:build !sqlite_trace
+
+package sqlite
+
+import (
+	"database/sql"
+	"database/sql/driver"
+	"strings"
+
+	gormsqlite "gorm.io/driver/sqlite"
+	"gorm.io/gorm"
+	moderncsqlite "modernc.org/sqlite"
+)
+
+const DriverName = "cpa_sqlite"
+
+type Config = gormsqlite.Config
+
+var pureGoDriver = &moderncsqlite.Driver{}
+
+func init() {
+	sql.Register(DriverName, pureGoDriver)
+}
+
+func Open(dsn string) gorm.Dialector {
+	separator := "?"
+	if strings.Contains(dsn, "?") {
+		separator = "&"
+	}
+	return New(Config{DSN: dsn + separator + "_busy_timeout=5000&_inttotime=1&_time_format=sqlite"})
+}
+
+func New(config Config) gorm.Dialector {
+	config.DriverName = DriverName
+	return gormsqlite.New(config)
+}
+
+func RegisterDeterministicScalarFunction(name string, argCount int32, function func(*moderncsqlite.FunctionContext, []driver.Value) (driver.Value, error)) error {
+	return pureGoDriver.RegisterDeterministicScalarFunction(name, argCount, function)
+}
